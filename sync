#!/bin/bash 
#!/bin/bash -x
scriptDir="$(cd "$(dirname "$0")"; pwd -P)"
source "$scriptDir/logging"

showHelp () 
{
  cat <<EOF
`basename "$0"` [options]

This script help sync change between SVN and Git repositories.

Options:

  --init SVN_FOLDER_PATH
      Setting up initial SVN branch for synchronize

  --svn SVN_URL
      Setting SVN URL. (Default $svnURL)

  --git GIT_URL
      Setting origin remote git URL. (Default $gitURL)

  --svnUser USERNAME
      Specify username for svn. (Default $svnUser)

  --svnPwd PASSWORD
      Specify svn password.

  --authors AUTHORS_FILE_LOCATION
      Specify authors files that contain a list of equation
      USER_NAME=USER_EMAIL. (Default $authorFile)

  -s, --strategy STRATEGY_NAME
      Specify git merge options. (Default is 
      $mergeOpt)

  -b, --branch BRANCH_NAME
      Specify git main branch to sync with SVN. (Default is $gitBranch)

  -r, --rebaseSync
      Use rebase to synchronize when svn and git branch as splited. 

  -m, --mergeSync
      Use merge to synchronize when svn and git branch as splited. 
      (Default)

  -n, --no-svnCommit
      Use to do a dry run dcommit on SVN. 

  -p, --prompt
      Will stop a major point and ask for check before continue.

  -d, --debug
      Will show all detail message for debugging the script.

EOF
} # end of showHelp

main () 
{
setDefaultSettings

# Go through all arguments
while [[ "$1" != "" ]]; do
  if [[ $1 =~ ^-h|--help$         ]]; then showHelp; myExit 0;                                  fi

  if [[ $1 =~ ^--init$            ]]; then init=("$2");                 shift; shift; continue; fi
  if [[ $1 =~ ^--svn$             ]]; then svnURL="$2";                 shift; shift; continue; fi
  if [[ $1 =~ ^--git$             ]]; then gitURL="$2";                 shift; shift; continue; fi
  if [[ $1 =~ ^--svnUser$         ]]; then svnUser="$2";                shift; shift; continue; fi
  if [[ $1 =~ ^--svnPwd$          ]]; then svnPwd="$2";                 shift; shift; continue; fi
  if [[ $1 =~ ^--authors$         ]]; then authorFile="$2";             shift; shift; continue; fi

  if [[ $1 =~ ^-s|--strategy$     ]]; then mergeOpt="$2";               shift; shift; continue; fi
  if [[ $1 =~ ^-b|--branch$       ]]; then gitBranch="$2";              shift; shift; continue; fi

  if [[ $1 =~ ^-r|--rebaseSync$   ]]; then rebaseSync="yes";            shift;        continue; fi
  if [[ $1 =~ ^-m|--mergeSync$    ]]; then rebaseSync="no";             shift;        continue; fi
  if [[ $1 =~ ^-n|--no-svnCommit$ ]]; then dcommitOpt="-n $dcommitOpt"; shift;        continue; fi
  if [[ $1 =~ ^-p|--prompt$       ]]; then prompt="yes";                shift;        continue; fi
  if [[ $1 =~ ^-d|--debug$        ]]; then LOG_LEVEL=$LOG_LEVEL_DEBUG;  shift;        continue; fi

  INFO "Unknown argument $1"
  exit 2
done

checkSettings
DBG "Use temp folder of $tmp"

get_gitattributes
init_fetchNewSvnFolder "${init[@]}"

local svnNewSHA="dummy"
local lfsNewSHA="dummy"

while [ "$run_again" != "no" ]; do
  run_again=no
  if [ "$svnNewSHA$lfsNewSHA" == "$svnSHA1$lfsSHA1" ]; then 
    INFO "****** No thing was updated Stop the sync loop"
    WARN "You may need to check to correct problem and run sync again"
    break; 
  fi

  get_svnInfo

  syncSVNtoGIT
  syncGITtoSVN

  svnNewSHA=`getSHA1 "$svnBranch"`
  lfsNewSHA=`getSHA1 "$lfsBranch"`
done

cleanUp
} # End of main

setDefaultSettings()
{
  curDir="`pwd`"
  myDir="`dirname "$0"`"
  tmp="/tmp/`basename $0`_`date +%m%d%y_%H%M%S`_$BASHPID"
  
  authorFile="../authors-transform.txt"
  rebaseSync="no"
  prompt="no"

  svnURL=
  dcommitOpt="--rmdir"

  local temp=`git config --local --get svn-remote.svn.url 2> /dev/null`
  if [ $? == 0 ]; then svnURL="`dirname "$temp"`"; fi


  gitURL=
  gitRemote=origin
  gitBranch="master"
  repoDir="$curDir"
  mergeOpt="-s recursive -Xours -Xpatience \
-Xignore-cr-at-eol -Xignore-space-at-eol"

  temp=`git config --local --get remote.${gitRemote}.url 2> /dev/null`
  if [ $? == 0 ]; then gitURL="${temp}"; fi


  init=()
} # End of setDefaultSettings

checkSettings()
{
  mkdir -p "$tmp"
  exitIfErr 1 "Cannot create folder $tmp!"

  authorFile="`realpath "$authorFile"`"

  # Check of setting correctness
  if [ ! -f "$authorFile" ]; then
    ERROR "`relPath "$authorFile"` is not found!"
    ERROR "****** Going to extract from SVN log."
    getSvnCommiters
    myExit 1
  fi

  cd "$repoDir"
  exitIfErr 1 "Cannot change to folder $repoDir!"

  if [ "$svnURL" == "" ]; then
    local temp=`git config --local --get svn-remote.svn.url 2> /dev/null`
    exitIfErr 1 "Please specify svn URL"
    svnURL="`dirname "$temp"`"; 
  fi

  if [ "$gitURL" == "" ]; then
    local temp=`git config --local --get remote.${gitRemote}.url 2> /dev/null`
    exitIfErr 1 "Please specify git URL"
    gitURL="${temp}"; 
  fi

  # check svn account
  if [ "$svnPwd" != "" ]; then
    svn info "$svnURL" --username "$svnUser" --password "$svnPwd" > /dev/null
    exitIfErr 1 "Cannot access svn with specified password!"
  elif [ "$svnUser" != "" ]; then
    echo $svnPwd | svn info "$svnURL" --username "$svnUser" > /dev/null
    exitIfErr 1 "Cannot access svn with specified user!"
  else
    echo $svnPwd | svn info "$svnURL" > /dev/null
    exitIfErr 1 "Cannot access to svn, please specify user and password!"
  fi

  local status=`git status -s` &> /dev/null
  exitIfErr 1 "$repoDir is not a git folder.\n\
    Please switch to git directory."

  if [[ "$status" != "" ]]; then
    ERROR "The working directory is dirty. Please do a git reset --hard"
    ERROR "Following are files that need to be taking care:"
    ERROR "$status"
    myExit 1
  fi

  filterLog="$tmp/filterLog.log"
}

cleanUp()
{
  #TODO: Unlock SVN folder
  #TODO: Unlock gitBranch
  rm -rf "$tmp" 2> /dev/null
  cd "$curDir" 2> /dev/null
}

init_fetchNewSvnFolder()
# $1 specify SVN path from relative to SVN ROOT
{
  if [ $# == 0 ]; then return; fi

  if [ "$1" == "" ]; then
    ERROR "missing SVN_FOLDER_PATH from --init option!".
    myExit 1
  fi

  svnFolder="${1//\//-}"
  svnRemote="svn-${svnFolder// /}"
  svnBranch="svn/${svnFolder// /}"
  if [[ "$lfsFilter" != "" ]]; then
    lfsBranch="svn/lfs/${svnFolder// /}"
  else
    lfsBranch="$svnBranch"
  fi

  local curBranch=`getCurBranch`
  if [[ "$curBranch" == "$lfsBranch" ]] || \
     [[ "$curBranch" == "$svnBranch" ]]; then
    git checkout -f "$gitBranch"
    exitIfErr 1 "Cannot switch to $gitBranch branch"
  fi

  git config --local --get remote.${gitRemote}.url 
  if [[ $? != 0 ]]; then
    INFO "****** Link ${gitRemote} to ${gitURL}/${svnFolder}"
    git remote add ${gitRemote} "${gitURL}/${svnFolder}"
  fi

  INFO "****** Create a svn remote under $svnRemote branch"
  git config --local svn-remote.svn.url   "$svnURL/$1"
  git config --local svn-remote.svn.fetch ":refs/remotes/$svnRemote"
  exitIfErr 1 "Cannot configure remote SVN to $svnURL!"
  rm -rf "$repoDir/.git/svn" 2> /dev/null

  git branch -D    "$lfsBranch" 2> /dev/null
  git branch -D    "$svnBranch" 2> /dev/null
  git branch -D -r "$svnRemote" 2> /dev/null

  INFO "****** Fetch SVN into $svnRemote"
  git checkout --orphan "${svnBranch}"
  exitIfErr 1 "Cannot checkout empty orphan branch of $svnRemote!"

  git reset --hard 2> /dev/null

  # Send password twice because there is a case where svn asked for
  # password second time if the git-svn layout version not match
  print "$svnPwd\n$svnPwd\n" | git svn fetch --username "$svnUser" \
    -A "$authorFile" 2> "$filterLog"
  exitIfErr 1 "Cannot fetch commits from SVN \\($svnURL\\)! due to:" '
    cat "'$filterLog'"'

  git checkout -f "$svnBranch"
  exitIfErr 1 "Cannot switch to $svnBranch"
  git reset --hard

  if [[ "$lfsFilter" != "" ]]; then
    INFO "****** Create new branch $lfsBranch"
    git branch "$lfsBranch" "$svnRemote"
    exitIfErr 1 "Cannot create $lfsBranch branch"

    git lfs uninstall --local

    INFO "****** Rebase SVN commits with lfs settings"
    git filter-branch --prune-empty -f --index-filter '
      cp "'${tmp}/.gitattributes'" .gitattributes
      git add .gitattributes
      ' -- "${lfsBranch}" 2> "$filterLog"
    exitIfErr 1 "Failed to apply LFS settings to $lfsBranch! due to:" '
      cat "'$filterLog'"'

    git lfs install
    git lfs migrate import --fixup "$lfsBranch"
    exitIfErr 1 "Failed to migrate to LFS"

    git update-ref -d "refs/original/refs/heads/$lfsBranch"
  fi

  local backupBranch="backup/${gitBranch}_`date +%m%d%y_%H%M%S`"
  git branch -f "$backupBranch" "$gitBranch"
  if [ $? == 0 ]; then
    INFO "****** Backup $gitBranch branch to $backupBranch"
  fi

  INFO "****** Set $gitBranch branch to $lfsBranch"; 
  git branch -f "$gitBranch" "$lfsBranch"
  exitIfErr 1 "Cannot set $gitBranch to $lfsBranch"

  git push -f -u $gitRemote "$lfsBranch"
  exitIfErr 1 "Cannot push $lfsBranch into $gitRemote"

  git push -f -u $gitRemote "$gitBranch"
  exitIfErr 1 "Cannot push $gitBranch into $gitRemote"

}

syncSVNtoGIT()
{
  local tryLfsMerge="try/lfs/fromSVN"

  INFO "###### Sync SVN commits to GIT ######"
  INFO "****** Fetch new commits from SVN to $svnRemote"
  git checkout -f "$svnBranch"
  exitIfErr 1 "Cannot switch to $svnBranch"
  git reset --hard

  #TODO: Lock SVN Folder
  echo $svnPwd | git svn fetch --username "$svnUser" \
    -A "$authorFile" 2> "$filterLog"
  exitIfErr 1 "Cannot fetch commits from SVN! due to:" '
    cat "'$filterLog'"'
  local svnNewSHA1=`getSHA1 "$svnRemote"`
  DBG "New SHA-1 for $svnRemote: $svnNewSHA1"

  if [[ $svnSHA1 == $svnNewSHA1 ]]; then
    INFO "Make sure $lfsBranch sync with the server"
    git push -f -u $gitRemote "$lfsBranch"
    exitIfErr 1 "Cannot push $lfsBranch to $gitRemote"

    INFO "No new SVN commits to work on."
    return
  fi

  # Rebase SVN changed into LFS (SVN changed = theirs)
  INFO "****** Put new SVN commits ${svnSHA1:0:8}..${svnNewSHA1:0:8} \
    onto $lfsBranch"

  git branch -f "$tryLfsMerge" "$svnRemote"
  exitIfErr 1 "Cannot create a temporary branch $tryLfsMerge"

  if [[ "$lfsFilter" != "" ]]; then
    INFO "** Apply LFS setting on new SVN commits on $svnRemote"

    INFO "Repair, and find new binary file for apply LFS"
    printf "$lfsFilter" > ${tmp}/.lfsFilter
    git filter-branch --prune-empty -f --index-filter '
      cp "'"${tmp}"'/.gitattributes" .gitattributes 
      git diff "'${svnBranch}'" --cached --name-only --diff-filter=ACR \
        | while read f; do
        git check-attr filter "$f" | grep "filter: unspecified$" > /dev/null
        if [ $? != 0 ]; then continue; fi

        git checkout-index -f -- "$f" 
        echo "$f" | perl -lne "exit 1 if -B"
        if [ $? == 0 ]; then continue; fi

        printf "\r"
        git lfs track "$f"
        printf ",$f">> '"${tmp}"'/.lfsFilter
      done

      git add .gitattributes
      cp .gitattributes "'"${tmp}"'/.gitattributes" 
      ' -- "${svnBranch}".."${tryLfsMerge}" 2> "$filterLog"
    exitIfErr 1 "Cannot apply LFS setting on new SVN commits!" '
      cat "'$filterLog'"'

    lfsFilter=`cat "${tmp}/.lfsFilter"`
    DBG "Current LFS Filter: $lfsFilter"

    if [ "$prompt" == "yes" ]; then
      read -p "Check if .gitattributes up-date correctly for new LFS files..."
    fi

    INFO "Migrate SVN commit to LFS"
    # It is often filter-branch along is not enough to convert file into
    # LFS - seem like file that modified are the once did not converted
    # into LFS
    git lfs migrate import  \
      --fixup \
      --exclude-ref="${svnBranch}" \
      --include-ref="${tryLfsMerge}"
    exitIfErr 1 "Failed to run lfs migrate on new SVN commits"

    if [ "$prompt" == "yes" ]; then
      read -p "Check if migrate still not converted all LFS..."
    fi
  fi

  INFO "Now rebase onto $lfsBranch"
  git rebase -s recursive -X theirs --keep-empty \
    --committer-date-is-author-date \
    --onto "$lfsBranch" "$svnBranch" "$tryLfsMerge"

  # This loop try to resolve some of the conflict that can be simply 
  # solve - such as:
  # * Removed files from git, but detected modified from SVN
  while [[ $? != 0 ]]; do
    local newHead=`cat .git/rebase-merge/current`

    INFO "**** Try to resolve conflict automatically at $newHead"

    if [[ $newHead == $oldHead ]]; then 
      ERROR "Cannot apply new SVN commit onto $lfsBranch!"
      if [ "$prompt" == "yes" ]; then 
        read -p "Check why rebase is failed..."
      fi 
      git rebase --abort
      myExit 1
    fi

    git status --porcelain > "$tmp/gitStatus"
    cat "$tmp/gitStatus"

    # Conflict ".D"
    # * A file deleted from SVN 
    sed -ne "s/^.D \(.*\)$/\1/p" "$tmp/gitStatus" \
      | while read f; do git rm "$f"; done

    # Code use to debug this process
    if [ "$prompt" == "yes" ]; then
      read -p "Check...."
    fi

    oldHead=$newHead
    git rebase --continue 2>> "$tmp/rebase"
  done;

  git filter-branch --env-filter '
    export GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME
    export GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
    export GIT_COMMITTER_DATE=$GIT_AUTHOR_DATE
  ' -f -- "$lfsBranch".."$tryLfsMerge"
  if [[ $? != 2 ]]; then
    exitIfErr 1 "Cannot readjust committer info onto $tryLfsMerge!"
  fi

  git branch -f "$lfsBranch"
  exitIfErr 1 "Cannot move $lfsBranch to new rebase tip!"
  local lfsNewSHA1=`getSHA1 "$lfsBranch"`
  DBG "New SHA-1 for $lfsBranch: $lfsNewSHA1"

  INFO "*** Go back to $svnBranch after rebase"
  git checkout -B "$svnBranch" "$svnRemote"
  exitIfErr 1 "Cannot switch and move $svnBranch to $svnRemote"
  git reset --hard

  git branch -D "${tryLfsMerge}" 2> /dev/null

  if [ "$prompt" == "yes" ]; then
    read -p "Check before push result into server...."
  fi

  git push -f -u $gitRemote "$lfsBranch"
  exitIfErr 1 "Cannot push $lfsBranch to $gitRemote"
}

syncGITtoSVN()
{
  INFO "###### Sync GIT commits to SVN ######"
  #       *--* <--gitBranch
  #     /
  # *--*--* <--lfsBranch
  #    ^
  #    +------ mergeBaseSHA1
  #
  local tryLfsMerge="try/lfs/merge"
  local tryMerge="try/merge"

  #TODO: Lock $gitBranch

  INFO "***** Update $gitBranch from git server"
  git fetch $gitRemote "$gitBranch"
  exitIfErr 1 "Cannot pull $gitBranch from $gitRemote"

  git branch -f "$gitBranch" $gitRemote/"$gitBranch"
  exitIfErr 1 "Cannot link $gitBranch with $gitRemote"

  local gitSHA=`getSHA1 "$gitBranch"`
  local lfsSHA=`getSHA1 "$lfsBranch"`
  if [ $gitSHA == $lfsSHA ]; then 
    INFO "Nothing to be syn."
    return;
  fi

  local mergeBaseSHA1=`git merge-base "$gitBranch" "$lfsBranch"`
  if [ "$mergeBaseSHA1" == "" ]; then
    ERROR "$gitBranch and $lfsBranch don't have common ancestor!."
    myExit 1
  fi
  INFO "$mergeBaseSHA1 is common ancestor of $gitBranch and $lfsBranch"

  local uncommitedCnt=0
  if [ $gitSHA == $mergeBaseSHA1 ]; then
    #    +------gitBranch
    #   \./
    # *--*--* <--lfsBranch
    INFO "****** Fast-forward $gitBranch to $lfsBranch"
    git branch -f "$gitBranch" "$lfsBranch"
    exitIfErr 1 "Cannot fast forward $gitBranch to $lfsBranch"
    
  else
    #       *--* <--gitBranch
    #     /
    # *--*--?--? <--lfsBranch
    #    ^
    #    +------ mergeBaseSHA1
    #
    # Rebase git commit into svnBranch for dcommit
    INFO "****** Put new git commits onto $svnRemote"
    git branch -f "$tryMerge" "$gitBranch"
    exitIfErr 1 "Cannot create branch from $gitBranch"

    git lfs uninstall --local

    local oldHead
    git rebase -s recursive -X theirs \
      --committer-date-is-author-date \
      --onto "$svnRemote" $mergeBaseSHA1 "$tryMerge" 2> "$tmp/rebase"

    # This loop try to resolve some of the conflict that can be simply 
    # solve - such as:
    # * Removed files from git, but detected modified from SVN
    while [[ $? != 0 ]]; do
      local newHead=`cat .git/rebase-merge/current`

      INFO "**** Try to resolve conflict automatically at $newHead"

      if [[ $newHead == $oldHead ]]; then 
        ERROR "Cannot rebase $gitBranch branch onto of $svnRemote!"
        git lfs install --local
        git rebase --abort
        myExit 1
      fi

      # Conflict "UD" - " unmerged, Deleted by theirs (master)
      # * A file added from SVN but remove by master
      git status --porcelain > "$tmp/gitStatus"
      cat "$tmp/gitStatus"
      sed -ne "s/^UD \(.*\)$/\1/p" "$tmp/gitStatus" \
        | while read f; do git rm "$f"; done

      # Handling submodule issues
      #
      # Obtain submodule files of any from master
      git show REBASE_HEAD:.gitmodules > "$tmp/.gitmodules"
      if [ $? == 0 ]; then
        sed -ne "s/^\(M \|UU\|DU\) \(.*\)$/\2/p" "$tmp/gitStatus" \
          | while read f; do
          if grep -i "= *$f *$" "$tmp/.gitmodules"; then
            git reset -- "$f";
          fi; 
        done
      fi

      # Conflict "DU" - " deleted by ours, unmerged
      # * A file may had been exist only in master all along, but now
      # changed - which required to add into SVN
      # * A file added from master, but had been removed by SVN
      #
      # * Exclude all .git* files, because it not part of SVN
      sed -ne "s/^DU \(\.git.*\)$/\1/p" "$tmp/gitStatus" \
        | while read f; do git reset -- "$f"; done

      git status --porcelain > "$tmp/gitStatus"
      sed -ne "s/^DU \(.*\)$/\1/p" "$tmp/gitStatus" \
        | while read f; do git add -- "$f"; done

      # Code use to debug this process
      if [ "$prompt" == "yes" ]; then
        read -p "Check...."
      fi

      oldHead=$newHead
      git rebase --continue 2>> "$tmp/rebase"

    done;

    if [[ "$lfsFilter" != "" ]]; then
      INFO "****** Remove submodules, and LFS settings"
      git filter-branch -f --index-filter '
      git checkout-index -f -- .gitmodules
      if [ $? == 0 ]; then
        sed -ne "s/^[\t ]*path *= *\(.*\) *$/\1/p" .gitmodules \
          | while read f; do git rm -rf -- "$f"; done
        git rm -f .gitmodules
      fi
      git rm -f .gitattributes

      git diff "'$svnRemote'" --cached --name-only --diff-filter=d \
        | while read f; do
        git checkout-index -f -- "$f"
        head -2 "$f" | sed -ne "s/^oid sha256:\([^ ]*\)/\1/p" \
          | while read ref; do
          ref="'$tmp'/lfs-$ref"
          if [ ! -f "$ref" ]; then
            cat "$f" | git lfs smudge > "$ref"
            if [ $? != 0 ]; then 
              rm -f "$ref"
              break 
            fi
            echo "  Remove LFS on $f"
          fi
          cp -f "$ref" "$f"
          git add "$f"
          break
        done
      done
      ' --prune-empty -- "$svnRemote".."$tryMerge" 2> "$filterLog"
      exitIfErr 1 "Cannot remove LFS settings from git commits!" '
        cat "'$filterLog'"
        rm -f "'$tmp'/"lfs-[0-9a-fA-F]*
        git lfs install --local
        '
      rm -f "$tmp/"lfs-[0-9a-fA-F]*
    else
      INFO "****** Remove submodule settings"
      git filter-branch -f --index-filter '
      git checkout-index -f -- .gitmodules
      if [ $? == 0 ]; then
        sed -ne "s/^[\t ]*path *= *\(.*\) *$/\1/p" .gitmodules \
          | while read f; do git rm -rf -- "$f"; done
        git rm -f .gitmodules
      fi
      git rm -f .gitattributes
      ' --prune-empty -- "$svnRemote".."$tryMerge" 2> "$filterLog"
      exitIfErr 1 "Cannot remove submodule settings from git commits!" '
        cat "'$filterLog'"
        git lfs install --local'
    fi

    git filter-branch --env-filter '
      export GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME
      export GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
      export GIT_COMMITTER_DATE=$GIT_AUTHOR_DATE
    ' -f -- "$svnRemote".."$tryMerge"
    if [[ $? != 2 ]]; then
      exitIfErr 1 "Cannot readjust committer info onto $tryMerge!" '
          git lfs install --local'
    fi

    git lfs install --local

    if [ "$prompt" == "yes" ]; then
      read -p "Check $tryMerge before run dcommit, Press Enter...."
    fi

    INFO "****** Do DCommit to push git commits into SVN server"
    echo $svnPwd | git svn dcommit --username "$svnUser" \
      --use-log-author --add-author-from \
      ${dcommitOpt} $tryMerge 2> "$filterLog"
    exitIfErr 1 "dcommit failed with following message:" '
      cat "'$filterLog'"
      git reset --hard 2>/dev/null'

    #This sometime is dangerous where the error from the git system
    #And may cause mis-calculation for readjustment code later on
    #if [ $? != 0 ]; then
    #  INFO ""
    #  WARN "DCommit failed with following message:"
    #  cat "$filterLog"
    #  INFO ""
    #fi

    #TODO: Unlock SVN Folder
    git reset --hard

    INFO "****** Figure what were committed into SVN and update the states"
    local newcommitCnt=`git rev-list --count "$svnBranch"..$tryMerge`
    local  commitedCnt=`git rev-list --count "$svnBranch"..$svnRemote`
    ((uncommitedCnt = newcommitCnt - commitedCnt ))
    INFO "There is $uncommitedCnt/$newcommitCnt uncommitted into SVN server"

    if [ "$prompt" == "yes" ]; then
      read -p "Check $svnRemote before update branches.Press Enter...."
    fi

    if [ "$rebaseSync" == "yes" ]; then
      INFO "****** Rebase $gitBranch onto $lfsBranch"
      git rebase ${mergeOpt} \
        --committer-date-is-author-date \
        --onto "$lfsBranch" $mergeBaseSHA1 "$gitBranch"
      exitIfErr 1 "Cannot rebase $gitBranch onto $lfsBranch!" '
        git rebase --abort 2>/dev/null'

      git filter-branch --env-filter '
        export GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME
        export GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
        export GIT_COMMITTER_DATE=$GIT_AUTHOR_DATE
      ' -f -- "$lfsBranch".."$gitBranch"
      if [[ $? != 2 ]]; then
        exitIfErr 1 "Cannot readjust committer info onto $gitBranch!"
      fi
    fi

    # Re-estimate commits that correct committed into SVN on gitBranch
    git branch -f "$tryLfsMerge" "$gitBranch"\~$uncommitedCnt
    exitIfErr 1 "Cannot mark commit wen through SVN on $gitBranch!"

    INFO "****** Try to update $lfsBranch and $gitBranch after dcommits"
    git checkout -f "$lfsBranch"
    exitIfErr 1 "Cannot checkout $lfsBranch!"

    if [ "$prompt" == "yes" ]; then
      read -p "Check before merge $lfsBranch, Press Enter...."
    fi

    git merge --ff ${mergeOpt} \
      -m "Auto merge $lfsBranch to $gitBranch" "$tryLfsMerge"
    exitIfErr 1 "Cannot merge $lfsBranch to $gitBranch!" '
      git merge --abort 2>/dev/null'


    git branch -f "$svnBranch" "$svnRemote"

    if [ "$prompt" == "yes" ]; then
      read -p "Check before rebase $gitBranch, Press Enter...."
    fi

    INFO "****** Rebase commits on gitBranch that not get to dcommit"
    git rebase \
      --committer-date-is-author-date \
      --onto "$lfsBranch" "$tryLfsMerge" "$gitBranch"
    exitIfErr 1 "Cannot rebase $gitBranch onto $lfsBranch!" '
      git rebase --abort 2>/dev/null'

    git filter-branch --env-filter '
      export GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME
      export GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
      export GIT_COMMITTER_DATE=$GIT_AUTHOR_DATE
    ' -f -- "$lfsBranch".."$gitBranch"
    if [[ $? != 2 ]]; then
      exitIfErr 1 "Cannot readjust committer info onto $gitBranch!"
    fi

    if [ "$prompt" == "yes" ]; then
      read -p "Check before push to stash, Press Enter...."
    fi

    git push -f -u $gitRemote "$lfsBranch"
    exitIfErr 1 "Cannot push $lfsBranch to $gitRemote"
  fi

  git push -f -u $gitRemote "$gitBranch"
  exitIfErr 1 "Cannot push $gitBranch into $gitRemote"
  #TODO: Unlock $gitBranch

  if [ "$prompt" == "yes" ]; then
    read -p "Check $gitBranch, $lfsBranch, $svnBranch. Press Enter...."
  fi

  INFO "****** Remove temporary branches"
  git checkout -f "$svnBranch"
  git branch -D "${tryLfsMerge}" 2> /dev/null
  git branch -D "${tryMerge}"   2> /dev/null

  INFO "****** Cleanup git report"
  git reflog expire
  git gc

  if [ $uncommitedCnt != 0 ]; then
    run_again=yes
  fi
}

get_gitattributes()
{
  # Capture project specific LFS setting
  git show "$gitBranch:.gitattributes" > "$tmp/.gitattributes" 2> /dev/null
  if [ $? == 0 ]; then
    # Extract all the file matching for LFS
    lfsFilter=`sed -nE \
      "s/^ *([^ ]*)  *filter=lfs .*$/\1/p" \
      "$tmp/.gitattributes" \
      | paste -sd ","`

  else

    NOTE "Cannot find .gitattributes from $gitBranch branch!"
    unset lfsFilter
  fi

  if [[ "$lfsFilter" == "" ]]; then
    NOTE "Not use LFS for this repository"
  else
    DBG  "LFS files are: $lfsFilter"
    #git lfs uninstall       &> /dev/null
    git lfs install --local 2> /dev/null
  fi
}

get_svnInfo()
{
  # Figure out svn branch, and folder name
  svnRemote=`git config --local --get svn-remote.svn.fetch`
  if [ "$svnRemote" == "" ]; then
    ERROR "Cannot found SVN branch!"
    ERROR "Please use --init SVN_FOLDER"
    myExit 1
  fi

  svnRemote="${svnRemote##*/}"
  svnFolder="${svnRemote##*svn-}"
  svnBranch="svn/$svnFolder"
  if [[ "$lfsFilter" != "" ]]; then
    lfsBranch="svn/lfs/$svnFolder"
  else
    lfsBranch="$svnBranch"
  fi

  lfsSHA1=`getSHA1 "$lfsBranch"`
  svnSHA1=`getSHA1 "$svnBranch"`

  DBG "SVN folder label: $svnFolder"
  DBG "SVN branch      : $svnSHA1 - $svnRemote"
  DBG "LFS sync branch : $lfsSHA1 - $lfsBranch"
}

getSvnCommiters()
{
  echo $svnPwd | svn log -q "$svnURL" > "$tmp/svn_log" 2> "$tmp/error"
  if [[ $? != 0 ]]; then 
    ERROR "Cannot query SVN log due to following error:"
    >&2 cat "$tmp/error"
    myExit $?; 
  fi

  cat "$tmp/svn_log" \
    | awk -F '|' \
             '/^r/ {sub("^ ", "", $2); sub(" $", "", $2);\
              print $2" = "$2" <"$2">"}' \
    | sort -u > "$authorFile"
  exitIfErr $? "Cannot process svn log!"

  INFO "PLEASE Fix committer Email in `relPath "$authorFile"` using following form:"
  INFO "  svnCommiterID = gitCommiterID <email>"
}

getSHA1()
{
  local sha1=`git log --pretty=oneline -1 "$1"` 2> /dev/null
  exitIfErr 1 "Fail to obtain SHA-1 number for branch $1"
  sha1="${sha1%% *}"
  echo "$sha1"
}

getCurBranch()
{
  local branch_name=$(git symbolic-ref -q HEAD)
  branch_name=${branch_name##refs/heads/}
  branch_name=${branch_name:-HEAD}
  echo $branch_name
}

relPath()
{
  echo `realpath --relative-to="$curDir" "$1"`
}

myExit()
{
  cleanUp
  exit $1
}

echo "Started on `date`"
EXIT_CMDS=(cleanUp)
main "$@"
