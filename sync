#!/bin/bash 
#!/bin/bash -x
PS4='Line ${LINENO}: ' #For debugging

showHelp () 
{
  cat <<EOF
`basename "$0"` [options]

This script help sync change between SVN and Git repositories.

Options:

  --init SVN_FOLDER_PATH
      Setting up initial SVN branch for synchronize

  --svn SVN_URL
      Setting SVN URL. (Default $svnURL)

  --git GIT_URL
      Setting origin remote git URL. (Default $gitURL)

  --svnUser
      Specify username for svn. (Default $svnUser)

  --svnPwd
      Specify svn passowrd.

  -s, --strategy
      Specify git merge options. (Default is $mergeOpt)

  -b, --branch
      Specify git main branch to sync with SVN. (Default is $gitBranch)

  -r, --rebaseSync
      Use rebase to synchronize when svn and git branch as splited. 
      (Default is using merge to synchronize)

EOF
} # end of showHelp

main () 
{
setDefaultSettings

# Go through all arguments
while (( "$#" )); do
  if [[ $1 =~ ^-h|--help$ ]]; then showHelp; myExit 0; fi
  if [[ $1 =~ ^--init$    ]]; then init=("$2"); shift; fi
  if [[ $1 =~ ^--svn$     ]]; then svnURL="$2"; shift; fi
  if [[ $1 =~ ^--git$     ]]; then gitURL="$2"; shift; fi
  if [[ $1 =~ ^--svnUser$ ]]; then svnURL="$2"; shift; fi
  if [[ $1 =~ ^--svnPwd$  ]]; then svnPwd="$2"; shift; fi
  if [[ $1 =~ ^-s|--strategy$ ]]; then mergeOpt="$2"; shift; fi
  if [[ $1 =~ ^-b|--branch$   ]]; then gitBranch="$2"; shift; fi
  if [[ $1 =~ ^-r|--rebaseSync$ ]]; then rebaseSync="yes"; fi
  shift
done

checkSettings
get_gitattributes
init_fetchNewSvnFolder "${init[@]}"

get_svnInfo
while [ "$run_again" != "no" ]; do
  run_again=no
  if [ "$svnNewSHA$lfsNewSHA" == "$svnSHA1$lfsSHA1" ]; then 
    echo "****** No thing was updated Stop the sync loop"
    echo "WARNING: You may need to check to correct problem and run sync again"
    break; 
  fi

  ##TODO: REMOVE - below block only for testing and DEBUG
  #git branch -f "$lfsBranch" bd4cdf9
  #get_svnInfo
  #svnSHA1="1edbd8422db"

  syncSVNtoGIT
  syncGITtoSVN

  local svnNewSHA=`getSHA1 "$svnBranch"`
  local lfsNewSHA=`getSHA1 "$lfsBranch"`
done

cleanUp
} # End of main

setDefaultSettings()
{
  curDir="`pwd`"
  myDir="`dirname "$0"`"
  tmp="/tmp/`basename $0`"
  
  authorFile="../authors-transform.txt"
  rebaseSync="no"

  gitURL="ssh://git@stash.XYZ.com:7999"
  gitRemote=origin
  gitBranch="master"
  repoDir="$curDir"
  mergeOpt="-s recursive -Xours -Xpatience \
    -Xignore-cr-at-eol -Xignore-space-at-eol"


  svnURL="http://ZYX846:8080/svn/projects"
  svnUser="ZYX"
  svnPwd="ZYX"
  dcommitOpt="-n --rmdir"

  init=()
} # End of setDefaultSettings

checkSettings()
{
  mkdir -p "$tmp"
  exitIfErr 1 echo "Cannot create folder $tmp!"

  authorFile="`realpath "$authorFile"`"

  # Check of setting correctness
  if [ ! -f "$authorFile" ]; then
    >&2 echo "`relPath "$authorFile"` is not found!"
    >&2 echo "****** Going to extract from SVN log."
    getSvnCommiters
    myExit 1
  fi

  cd "$repoDir"
  local status=`git status -s` &> /dev/null
  exitIfErr 1 echo "$repoDir is not a git folder.\n\
    Please switch to git directory."

  if [[ "$status" != "" ]]; then
    >&2 echo "The working directory is dirty. Please do a git reset --hard"
    >&2 echo "Following are files that need to be taking care:"
    >&2 echo "$status"
    myExit 1
  fi

  filterLog="$tmp/filterLog.log"
}

cleanUp()
{
  #TODO: Unlock SVN folder
  #TODO: Unlock gitBranch
  rm -rf "$tmp" 2> /dev/null
  cd "$curDir" 2> /dev/null
}

init_fetchNewSvnFolder()
# $1 specify SVN path from relative to SVN ROOT
{
  if [ $# == 0 ]; then return; fi

  if [ "$1" == "" ]; then
    >&2 echo "missing SVN_FOLDER_PATH from --init option!".
    myExit 1
  fi

  svnFolder="${1/\//-}"
  svnRemote="svn-$svnFolder"
  svnBranch="svn/$svnFolder"
  lfsBranch="svn/lfs/$svnFolder"

  local curBranch=`getCurBranch`
  if [[ "$curBranch" == "$lfsBranch" ]] || \
     [[ "$curBranch" == "$svnBranch" ]]; then
    git checkout -f "$gitBranch"
    exitIfErr 1 echo "Cannot switch to $gitBranch branch"
  fi

  echo "****** Create a svn remote under $svnRemote branch"
  git config svn-remote.svn.url   "$svnURL/$1"
  git config svn-remote.svn.fetch ":refs/remotes/$svnRemote"
  exitIfErr 1 echo "Cannot configure remote SVN to $svnURL!"
  rm -rf "$repoDir/.git/svn" 2> /dev/null

  git branch -D    "$lfsBranch" 2> /dev/null
  git branch -D    "$svnBranch" 2> /dev/null
  git branch -D -r "$svnRemote" 2> /dev/null

  echo "****** Fetch SVN into $svnRemote"
  git checkout --orphan "svn/${svnFolder}"
  exitIfErr 1 echo "Cannot checkout empty orphan branch of $svnRemote!"

  git reset --hard 2> /dev/null

  git svn fetch -A "$authorFile" 2> "$filterLog"
  exitIfErr 1 \
    echo "Cannot fetch commits from SVN ($svnURL)! due to;" ";" \
    cat "$filterLog"


  echo "****** Create new branch $lfsBranch"
  git branch "$lfsBranch" "$svnRemote"
  exitIfErr 1 echo "Cannot create $lfsBranch branch"

  git checkout -f "$svnBranch"
  exitIfErr 1 echo "Cannot switch to $svnBranch"
  git reset --hard

  echo "****** Rebase SVN commits with lfs settings"
  git filter-branch --prune-empty -f --tree-filter " \
    cp \"${tmp}/.gitattributes\" .gitattributes;     \
    " -- "${lfsBranch}" 2> "$filterLog"
  exitIfErr 1 \
    echo "Failed to apply LFS settings to $lfsBranch! due to:" ";" \
    cat "$filterLog"

  git lfs migrate import --include="$lfsFilter" "$lfsBranch"
  exitIfErr 1 echo "Failed to migrate to LFS"

  git update-ref -d "refs/original/refs/heads/$lfsBranch"

  local backupBranch="backup/${gitBranch}_`date +%m%d%y_%H%M%S`"
  echo "****** Backup and set $gitBranch branch to $lfsBranch"; 
  git branch -f "$backupBranch" "$gitBranch"
  exitIfErr 1 echo "Cannot backup $gitBranch"

  git branch -f "$gitBranch" "$lfsBranch"
  exitIfErr 1 echo "Cannot set $gitBranch to $lfsBranch"

  git push -f -u $gitRemote "$gitBranch"
  exitIfErr 1 echo "Cannot push $gitBranch into $gitRemote"
}

syncSVNtoGIT()
{
  echo "###### Sync SVN commits to GIT ######"
  echo "****** Fetch new commits from SVN to $svnRemote"
  git checkout -f "$svnBranch"
  exitIfErr 1 echo "Cannot switch to $svnBranch"
  git reset --hard

  #TODO: Lock SVN Folder
  git svn fetch -A "$authorFile" 2> "$filterLog"
  exitIfErr 1 echo "Cannot fetch commits from SVN! due to:" ";" \
    cat "$filterLog"
  svnNewSHA1=`getSHA1 "$svnRemote"`
  DBG "New SHA-1 for $svnRemote: $svnNewSHA1"

  if [[ $svnSHA1 == $svnNewSHA1 ]]; then
    echo "No new SVN commits to work on."
    return
  fi

  # Rebase SVN changed into LFS (SVN changed = theirs)
  echo "****** Put new SVN commit from ${svnSHA1:0:8} onto $lfsBranch"
  git rebase -s recursive -X theirs --onto "$lfsBranch" $svnSHA1 $svnNewSHA1
  if [ ! $? == 0 ]; then
    git rebase --abort 2> /dev/null
    >&2 echo "Cannot apply new SVN commit onto $lfsBranch!"
    myExit 1
  fi

  git branch -f "$lfsBranch"
  exitIfErr 1 echo "Cannot move $lfsBranch to new rebase tip!"
  lfsNewSHA1=`getSHA1 "$lfsBranch"`
  DBG "New SHA-1 for $lfsBranch: $svnNewSHA1"

  echo "****** Go back to $svnBranch after rebase"
  git checkout -f "$svnBranch"
  exitIfErr 1 echo "Cannot switch to $svnBranch"
  git reset --hard

  echo "Apply LFS setting on new commits ${lfsSHA1:0:8}..$lfsBranch"
  git filter-branch --prune-empty -f --tree-filter " \
    cp \"${tmp}/.gitattributes\" .gitattributes;     \
    " -- ${lfsSHA1}.."${lfsBranch}" 2> "$filterLog"
  exitIfErr 1 echo "Cannot apply LFS setting on new SVN commits!" ";" \
    cat "$filterLog"

  git lfs migrate import  \
    --include="$lfsFilter" \
    --exclude-ref=${lfsSHA1} \
    --include-ref="${lfsBranch}"
  exitIfErr 1 echo "Failed to run lfs migrate to LFS"

  #TODO: Check consitencyr 
  #git log --name-only --oneline | sed -E "s/^[0-9a-f]+ /0000 /" >/tmp/a5
  #git log --name-only --oneline | sed -E "/\.gitattributes.*/d" | sed -E "s/^[0-9a-f]+ (.*) git-svn-id:.*$/0000 \1/" >/tmp/a5
   
  lfsNewSHA1=`getSHA1 "$lfsBranch"`
  DBG "New SHA-1 for $lfsBranch: $lfsNewSHA1"

  git push -f -u $gitRemote "$lfsBranch"
  exitIfErr 1 echo "Cannot push $lfsBranch to $gitRemote"
}

syncGITtoSVN()
{
  echo "###### Sync GIT commits to SVN ######"
  #       *--* <--gitBranch
  #     /
  # *--*--* <--lfsBranch
  #
  local tryLfsMerge="try/lfs/merge"
  local tryMerge="try/merge"

  #TODO: Lock $gitBranch

  echo "***** Update $gitBranch from git server"
  git fetch $gitRemote "$gitBranch"
  exitIfErr 1 echo "Cannot fetch $gitBranch from $gitRemote"

  git branch -f "$gitBranch" $gitRemote/"$gitBranch"
  exitIfErr 1 echo "Cannot link $gitBranch with $gitRemote"

  local gitSHA=`getSHA1 "$gitBranch"`
  local lfsSHA=`getSHA1 "$lfsBranch"`
  if [ $gitSHA == $lfsSHA ]; then 
    echo "Nothing to be syn."
    return;
  fi

  local mergeBaseSHA1=`git merge-base "$gitBranch" "$lfsBranch"`
  if [ "$mergeBaseSHA1" == "" ]; then
    >&2 echo "$gitBranch and $lfsBranch don't have common ancestor!."
    myExit 1
  fi
  echo "$mergeBaseSHA1 is common ancestor of $gitBranch and $lfsBranch"

  if [ "$rebaseSync" == "yes" ]; then
    echo "****** Rebase $gitBranch onto $lfsBranch"
    git rebase ${mergeOpt} --onto "$lfsBranch" $mergeBaseSHA1 "$gitBranch"
    exitIfErr 1 echo "Cannot rebase $gitBranch onto $lfsBranch!"

    mergeBaseSHA1=`getSHA1 "$lfsBranch"`

  elif [ `getSHA1 "$gitBranch"` == $mergeBaseSHA1 ]; then
    echo "****** Fast Forward $gitBranch."
    git checkout -f "$gitBranch" 
    exitIfErr 1 echo "Cannot checkout $gitBranch!"

    git merge --ff-only "${lfsBranch}"
    exitIfErr 1 echo "Cannot fast forward $gitBranch!"
  fi

  git branch -D $tryLfsMerge 2> /dev/null
  git branch -D $tryMerge    2> /dev/null
  
  git checkout -f -B $tryLfsMerge "$lfsBranch"
  exitIfErr 1 echo "Cannot checkout $lfsBranch!"
  git reset --hard

  if [ `getSHA1 "$lfsBranch"` == $mergeBaseSHA1 ]; then
    echo "****** Fast Forward $lfsBranch."
    git merge --ff-only "${gitBranch}"
    exitIfErr 1 echo "Cannot fast forward $gitBranch!"

    #TODO: Unlock $gitBranch if the merge result only fast forwarded
  else
    echo "****** Try to merge $lfsBranch to $gitBranch"
    git merge ${mergeOpt} -m "Auto merge $lfsBranch to $gitBranch" "$gitBranch"
    exitIfErr 1 echo "Cannot merge $lfsBranch to $gitBranch!" ";" \
      git merge --abort "2>" /dev/null
  fi

  git branch -f $tryMerge $tryLfsMerge
  exitIfErr 1 echo "Cannot create $tryMerge branch!"

  echo "****** Remove LFS settings"
  git filter-branch -f --tree-filter 'rm -f .gitattributes' \
    -- "$lfsBranch".."$tryMerge" 2> "$filterLog"
  exitIfErr 1 echo "Cannot remove LFS settings from git commits!" ";" \
    cat "$filterLog"
  
  echo "****** Put new git commits onto $svnRemote"
  git rebase --onto "$svnRemote" $mergeBaseSHA1 "$tryMerge"
  exitIfErr 1 echo "Cannot rebase $tryLfsMerge branch onto of $svnRemote!"

  echo "****** Do DCommit to push git commits into SVN server"
  git svn dcommit --no-rebase ${dcommitOpt} $tryMerge 2> "$filterLog"
  if [ $? != 0 ]; then
    echo ""
    echo "WARNING: DCommit failed with following message:"
    cat "$filterLog"
    echo ""
    # TODO: Is continue with reset --hard work?
  fi
  #TODO: Unlock SVN Folder
  git reset --hard

  echo "****** Figure what were committed into SVN and update the states"
  local newcommitCnt=`git log --oneline "$svnBranch"..$tryMerge | wc -l`
  local uncommitedCnt=`git log --oneline "$svnRemote"..$tryMerge | wc -l`
  echo "There is $uncommitedCnt/$newcommitCnt not committed into SVN server"

  if [ $uncommitedCnt != $newcommitCnt ]; then
    local lfsSHA=`getSHA1 "$tryLfsMerge"\~$uncommitedCnt`
    git branch -f "$lfsBranch" "$tryLfsMerge"\~$uncommitedCnt
    exitIfErr 1 echo "Cannot move $lfsBranch to $lfsSHA"

    git branch -f "$svnBranch"  "$tryMerge"\~$uncommitedCnt
    exitIfErr 1 echo "Cannot move $svnBranch to $svnRemote"

    git push -f -u $gitRemote "$lfsBranch"
    exitIfErr 1 echo "Cannot push $lfsBranch to $gitRemote"
  fi

  if [ $uncommitedCnt == 0 ]; then
    local gitSHA=`getSHA1 "$gitBranch"`
    local lfsSHA=`getSHA1 "$lfsBranch"`
    if [ $gitSHA != $lfsSHA ]; then 
      git branch -f "$gitBranch" "$lfsBranch"
      git push -f -u $gitRemote "$gitBranch"
      exitIfErr 1 echo "Cannot push $gitBranch into $gitRemote"
    fi
  fi
  #TODO: Unlock $gitBranch

  echo "****** Remove temporary branches"
  git checkout -f "$svnBranch"
  git branch -D "${tryLfsMerge}"
  git branch -D "${tryMerge}"

  echo "****** Cleanup git report"
  git reflog expire
  git gc

  if [ $uncommitedCnt != 0 ]; then
    run_again=yes
  fi
}

get_gitattributes()
{
  # Capture project specific LFS setting
  git show "$gitBranch:.gitattributes" > "$tmp/.gitattributes" 2> /dev/null
  lfsFilter=`sed -nE "s/ *([^ ]*)  *filter=lfs .*/\1/p" \
                 "$tmp/.gitattributes" \
             | paste -sd ","`
  DBG "LFS Filter are $lfsFilter"
  exitIfErr 1 echo "Cannot find .gitattributes from $gitBranch branch!"
}

get_svnInfo()
{
  # Figure out svn branch, and folder name
  svnRemote=`git config --get svn-remote.svn.fetch`
  if [ "$svnRemote" == "" ]; then
    >&2 echo "Cannot found SVN branch!"
    >&2 echo "Please use --init SVN_FOLDER"
    myExit 1
  fi

  svnRemote="${svnRemote##*/}"
  svnFolder="${svnRemote##*svn-}"
  svnBranch="svn/$svnFolder"
  lfsBranch="svn/lfs/$svnFolder"

  lfsSHA1=`getSHA1 "$lfsBranch"`
  svnSHA1=`getSHA1 "$svnRemote"`

  DBG "SVN folder label: $svnFolder"
  DBG "SVN branch      : $svnSHA1 - $svnRemote"
  DBG "LFS sync branch : $lfsSHA1 - $lfsBranch"
}

getSvnCommiters()
{
  svn log -q "$svnURL" \
    --username "$svnUser" \
    --password "$svnPwd" > "$tmp/svn_log" 2> "$tmp/error"
  if [[ $? != 0 ]]; then 
    >&2 echo "Cannot query SVN log due to following error:"
    >&2 cat "$tmp/error"
    myExit $?; 
  fi

  cat "$tmp/svn_log" \
    | awk -F '|' \
             '/^r/ {sub("^ ", "", $2); sub(" $", "", $2);\
              print $2" = "$2" <"$2">"}' \
    | sort -u > "$authorFile"
  exitIfErr $? echo "Cannot process svn log!"

  echo "PLEASE Fix committer Email in `relPath "$authorFile"` using following form:"
  echo "  svnCommiterID = gitCommiterID <email>"
}

getSHA1()
{
  local sha1=`git log --pretty=oneline -1 "$1"` 2> /dev/null
  exitIfErr 1 echo "Fail to obtain SHA-1 number for branch $1"
  sha1="${sha1%% *}"
  echo "$sha1"
}

getCurBranch()
{
  local branch_name=$(git symbolic-ref -q HEAD)
  branch_name=${branch_name##refs/heads/}
  branch_name=${branch_name:-HEAD}
  echo $branch_name
}

relPath()
{
  echo `realpath --relative-to="$curDir" "$1"`
}

# $1 - Error code
# $2 - Error message
exitIfErr()
{
  if [ ! $? == 0 ]; then
    local error=$1
    shift
    if [[ $# != 0 ]]; then (>&2 eval "$@") fi
    myExit $error
  fi
}

myExit()
{
  cleanUp
  exit $1
}

DBG()
{
  local line=`caller`
  line=${line%% *}
  echo "DEBUG:${line:0:4} $@"
  /dev/null
}

main "$@"
