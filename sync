#!/bin/bash 
#!/bin/bash -x
PS4='Line ${LINENO}: ' #For debugging

showHelp () 
{
  cat <<EOF
`basename "$0"` [options]

This script help sync change between SVN and Git repositories.

Options:

  --init SVN_FOLDER_PATH
      Setting up initial SVN branch for synchronize

  --svn SVN_URL
      Setting SVN URL. (Default $svnURL)

  --git GIT_URL
      Setting origin remote git URL. (Default $gitURL)

  --svnUser
      Specify username for svn. (Default $svnUser)

  --svnPwd
      Specify svn passowrd.

  -s, --strategy STRATEGY_NAME
      Specify git merge options. (Default is $mergeOpt)

  -b, --branch BRANCH_NAME
      Specify git main branch to sync with SVN. (Default is $gitBranch)

  -r, --rebaseSync
      Use rebase to synchronize when svn and git branch as splited. 

  -m, --mergeSync
      Use merge to synchronize when svn and git branch as splited. 
      (Default)

  -n, --no-svnCommit
      Use to do a dry run dcommit on SVN. 

  -p, --prompt
      Will stop a major point and ask for check before continue.

  -d, --debug
      Will show all detail message for debugging the script.

EOF
} # end of showHelp

main () 
{
setDefaultSettings

# Go through all arguments
while [[ "$1" != "" ]]; do
  if [[ $1 =~ ^-h|--help$         ]]; then showHelp; myExit 0;                                  fi

  if [[ $1 =~ ^--init$            ]]; then init=("$2");                 shift; shift; continue; fi
  if [[ $1 =~ ^--svn$             ]]; then svnURL="$2";                 shift; shift; continue; fi
  if [[ $1 =~ ^--git$             ]]; then gitURL="$2";                 shift; shift; continue; fi
  if [[ $1 =~ ^--svnUser$         ]]; then svnUser="$2";                shift; shift; continue; fi
  if [[ $1 =~ ^--svnPwd$          ]]; then svnPwd="$2";                 shift; shift; continue; fi
  if [[ $1 =~ ^-s|--strategy$     ]]; then mergeOpt="$2";               shift; shift; continue; fi
  if [[ $1 =~ ^-b|--branch$       ]]; then gitBranch="$2";              shift; shift; continue; fi

  if [[ $1 =~ ^-r|--rebaseSync$   ]]; then rebaseSync="yes";            shift;        continue; fi
  if [[ $1 =~ ^-m|--mergeSync$    ]]; then rebaseSync="no";             shift;        continue; fi
  if [[ $1 =~ ^-n|--no-svnCommit$ ]]; then dcommitOpt="-n $dcommitOpt"; shift;        continue; fi
  if [[ $1 =~ ^-p|--prompt$       ]]; then prompt="yes";                shift;        continue; fi
  if [[ $1 =~ ^-d|--debug$        ]]; then dbg="yes";                   shift;        continue; fi

  echo "Unknown argument $1"
  exit 2
done

checkSettings
get_gitattributes
init_fetchNewSvnFolder "${init[@]}"

get_svnInfo
while [ "$run_again" != "no" ]; do
  run_again=no
  if [ "$svnNewSHA$lfsNewSHA" == "$svnSHA1$lfsSHA1" ]; then 
    echo "****** No thing was updated Stop the sync loop"
    echo "WARNING: You may need to check to correct problem and run sync again"
    break; 
  fi

  ##TODO: REMOVE - below block only for testing and DEBUG
  #git branch -f "$lfsBranch" bd4cdf9
  #get_svnInfo
  #svnSHA1="1edbd8422db"

  syncSVNtoGIT
  syncGITtoSVN

  local svnNewSHA=`getSHA1 "$svnBranch"`
  local lfsNewSHA=`getSHA1 "$lfsBranch"`
done

cleanUp
} # End of main

setDefaultSettings()
{
  curDir="`pwd`"
  myDir="`dirname "$0"`"
  tmp="/tmp/`basename $0`_`date +%m%d%y_%H%M%S`_$BASHPID"
  DBG "Use temp folder of $tmp"
  
  authorFile="../authors-transform.txt"
  rebaseSync="no"
  prompt="no"
  dbg="no"

  svnURL="http://xyz:8080/svn/projects"
  dcommitOpt="--rmdir"

  gitURL="ssh://git@stash.xyz.com:7999/ABC/XYZ.git"
  gitRemote=origin
  gitBranch="master"
  repoDir="$curDir"
  mergeOpt="-s recursive -Xours -Xpatience \
    -Xignore-cr-at-eol -Xignore-space-at-eol"


  init=()
} # End of setDefaultSettings

checkSettings()
{
  mkdir -p "$tmp"
  exitIfErr 1 echo "Cannot create folder $tmp!"

  authorFile="`realpath "$authorFile"`"

  # Check of setting correctness
  if [ ! -f "$authorFile" ]; then
    >&2 echo "`relPath "$authorFile"` is not found!"
    >&2 echo "****** Going to extract from SVN log."
    getSvnCommiters
    myExit 1
  fi

  # check svn account
  if [ "$svnPwd" != "" ]; then
    svn info "$svnURL" --username "$svnUser" --password "$svnPwd" > /dev/null
    exitIfErr 1 echo "Cannot access svn with specified password!"
  elif [ "$svnUser" != "" ]; then
    echo $svnPwd | svn info "$svnURL" --username "$svnUser" > /dev/null
    exitIfErr 1 echo "Cannot access svn with specified user!"
  else
    echo $svnPwd | svn info "$svnURL" > /dev/null
    exitIfErr 1 echo "Cannot access to svn, please specify user and password!"
  fi

  cd "$repoDir"
  local status=`git status -s` &> /dev/null
  exitIfErr 1 echo "$repoDir is not a git folder.\n\
    Please switch to git directory."

  if [[ "$status" != "" ]]; then
    >&2 echo "The working directory is dirty. Please do a git reset --hard"
    >&2 echo "Following are files that need to be taking care:"
    >&2 echo "$status"
    myExit 1
  fi

  filterLog="$tmp/filterLog.log"
}

cleanUp()
{
  #TODO: Unlock SVN folder
  #TODO: Unlock gitBranch
  rm -rf "$tmp" 2> /dev/null
  cd "$curDir" 2> /dev/null
  git lfs install --skip-repo &> /dev/null
}

init_fetchNewSvnFolder()
# $1 specify SVN path from relative to SVN ROOT
{
  if [ $# == 0 ]; then return; fi

  if [ "$1" == "" ]; then
    >&2 echo "missing SVN_FOLDER_PATH from --init option!".
    myExit 1
  fi

  svnFolder="${1//\//-}"
  svnRemote="svn-$svnFolder"
  svnBranch="svn/$svnFolder"
  if [[ "$lfsFilter" != "" ]]; then
    lfsBranch="svn/lfs/$svnFolder"
  else
    lfsBranch="$svnBranch"
  fi

  local curBranch=`getCurBranch`
  if [[ "$curBranch" == "$lfsBranch" ]] || \
     [[ "$curBranch" == "$svnBranch" ]]; then
    git checkout -f "$gitBranch"
    exitIfErr 1 echo "Cannot switch to $gitBranch branch"
  fi

  git config --local --get remote.${gitRemote}.url
  if [[ $? != 0 ]]; then
    echo "****** Link ${gitRemote} to ${gitURL}/${svnFolder}"
    git remote add ${gitRemote} "${gitURL}/${svnFolder}"
  fi

  echo "****** Create a svn remote under $svnRemote branch"
  git config svn-remote.svn.url   "$svnURL/$1"
  git config svn-remote.svn.fetch ":refs/remotes/$svnRemote"
  exitIfErr 1 echo "Cannot configure remote SVN to $svnURL!"
  rm -rf "$repoDir/.git/svn" 2> /dev/null

  git branch -D    "$lfsBranch" 2> /dev/null
  git branch -D    "$svnBranch" 2> /dev/null
  git branch -D -r "$svnRemote" 2> /dev/null

  echo "****** Fetch SVN into $svnRemote"
  git checkout --orphan "svn/${svnFolder}"
  exitIfErr 1 echo "Cannot checkout empty orphan branch of $svnRemote!"

  git reset --hard 2> /dev/null

  echo $svnPwd | git svn fetch -A "$authorFile" 2> "$filterLog"
  exitIfErr 1 \
    echo "Cannot fetch commits from SVN \\($svnURL\\)! due to;" ";" \
    cat "$filterLog"

  git checkout -f "$svnBranch"
  exitIfErr 1 echo "Cannot switch to $svnBranch"
  git reset --hard

  if [[ "$lfsFilter" != "" ]]; then
    echo "****** Create new branch $lfsBranch"
    git branch "$lfsBranch" "$svnRemote"
    exitIfErr 1 echo "Cannot create $lfsBranch branch"

    echo "****** Rebase SVN commits with lfs settings"
    git filter-branch --prune-empty -f --tree-filter " \
      cp \"${tmp}/.gitattributes\" .gitattributes;     \
      " -- "${lfsBranch}" 2> "$filterLog"
    exitIfErr 1 \
      echo "Failed to apply LFS settings to $lfsBranch! due to:" ";" \
      cat "$filterLog"

    git lfs migrate import --include="$lfsFilter" "$lfsBranch"
    exitIfErr 1 echo "Failed to migrate to LFS"

    git update-ref -d "refs/original/refs/heads/$lfsBranch"
  fi

  local backupBranch="backup/${gitBranch}_`date +%m%d%y_%H%M%S`"
  git branch -f "$backupBranch" "$gitBranch"
  if [ $? == 0 ]; then
    echo "****** Backup $gitBranch branch to $backupBranch"
  fi

  echo "****** Set $gitBranch branch to $lfsBranch"; 
  git branch -f "$gitBranch" "$lfsBranch"
  exitIfErr 1 echo "Cannot set $gitBranch to $lfsBranch"

  git push -f -u $gitRemote "$lfsBranch"
  exitIfErr 1 echo "Cannot push $lfsBranch into $gitRemote"

  git push -f -u $gitRemote "$gitBranch"
  exitIfErr 1 echo "Cannot push $gitBranch into $gitRemote"

}

syncSVNtoGIT()
{
  echo "###### Sync SVN commits to GIT ######"
  echo "****** Fetch new commits from SVN to $svnRemote"
  git checkout -f "$svnBranch"
  exitIfErr 1 echo "Cannot switch to $svnBranch"
  git reset --hard

  #TODO: Lock SVN Folder
  echo $svnPwd | git svn fetch \
    -A "$authorFile" 2> "$filterLog"
  exitIfErr 1 echo "Cannot fetch commits from SVN! due to:" ";" \
    cat "$filterLog"
  local svnNewSHA1=`getSHA1 "$svnRemote"`
  DBG "New SHA-1 for $svnRemote: $svnNewSHA1"

  if [[ $svnSHA1 == $svnNewSHA1 ]]; then
    echo "No new SVN commits to work on."
    return
  fi

  if [[ "$lfsFilter" != "" ]]; then
    # Rebase SVN changed into LFS (SVN changed = theirs)
    echo "****** Put new SVN commit from ${svnSHA1:0:8} onto $lfsBranch"

    # Uninstall LFS to avoid the error like should be a point but..
    git lfs uninstall --local 2> /dev/null

    git rebase -s recursive -X theirs --keep-empty \
      --onto "$lfsBranch" $svnSHA1 $svnNewSHA1
    local error=$?

    git lfs install --local 2> /dev/null
    if [ ! $error == 0 ]; then
      git rebase --abort 2> /dev/null
      >&2 echo "Cannot apply new SVN commit onto $lfsBranch!"
      myExit 1
    fi

    git branch -f "$lfsBranch"
    exitIfErr 1 echo "Cannot move $lfsBranch to new rebase tip!"
    local lfsNewSHA1=`getSHA1 "$lfsBranch"`
    DBG "New SHA-1 for $lfsBranch: $svnNewSHA1"

    echo "****** Go back to $svnBranch after rebase"
    git checkout -f "$svnBranch"
    exitIfErr 1 echo "Cannot switch to $svnBranch"
    git reset --hard

    echo "Apply LFS setting on new commits ${lfsSHA1:0:8}..$lfsBranch"
    git filter-branch --prune-empty -f --tree-filter " \
      cp \"${tmp}/.gitattributes\" .gitattributes;     \
      " -- ${lfsSHA1}.."${lfsBranch}" 2> "$filterLog"
    exitIfErr 1 echo "Cannot apply LFS setting on new SVN commits!" ";" \
      cat "$filterLog"

    # It is often filter-branch along is not enough to convert file into
    # LFS - seem like file that modified are the once did not converted
    # into LFS
    git lfs migrate import  \
      --include="$lfsFilter" \
      --exclude-ref=${lfsSHA1} \
      --include-ref="${lfsBranch}"
    exitIfErr 1 echo "Failed to run lfs migrate to LFS"

    lfsNewSHA1=`getSHA1 "$lfsBranch"`
    DBG "New SHA-1 for $lfsBranch: $lfsNewSHA1"
  fi

  git reset --hard $svnNewSHA1

  git push -f -u $gitRemote "$lfsBranch"
  exitIfErr 1 echo "Cannot push $lfsBranch to $gitRemote"
}

syncGITtoSVN()
{
  echo "###### Sync GIT commits to SVN ######"
  #       *--* <--gitBranch
  #     /
  # *--*--* <--lfsBranch
  #    ^
  #    +------ mergeBaseSHA1
  #
  local tryLfsMerge="try/lfs/merge"
  local tryMerge="try/merge"

  #TODO: Lock $gitBranch

  echo "***** Update $gitBranch from git server"
  git fetch $gitRemote "$gitBranch"
  exitIfErr 1 echo "Cannot pull $gitBranch from $gitRemote"

  git branch -f "$gitBranch" $gitRemote/"$gitBranch"
  exitIfErr 1 echo "Cannot link $gitBranch with $gitRemote"

  local gitSHA=`getSHA1 "$gitBranch"`
  local lfsSHA=`getSHA1 "$lfsBranch"`
  if [ $gitSHA == $lfsSHA ]; then 
    echo "Nothing to be syn."
    return;
  fi

  local mergeBaseSHA1=`git merge-base "$gitBranch" "$lfsBranch"`
  if [ "$mergeBaseSHA1" == "" ]; then
    >&2 echo "$gitBranch and $lfsBranch don't have common ancestor!."
    myExit 1
  fi
  echo "$mergeBaseSHA1 is common ancestor of $gitBranch and $lfsBranch"

  local uncommitedCnt=0
  if [ $gitSHA == $mergeBaseSHA1 ]; then
    #    +------gitBranch
    #   \./
    # *--*--* <--lfsBranch
    echo "****** Fast-forward $gitBranch to $lfsBranch"
    git branch -f "$gitBranch" "$lfsBranch"
    exitIfErr 1 echo "Cannot fast forward $gitBranch to $lfsBranch"
    
  else
    #       *--* <--gitBranch
    #     /
    # *--*--?--? <--lfsBranch
    #    ^
    #    +------ mergeBaseSHA1
    #
    # Rebase git commit into svnBranch for dcommit
    echo "****** Put new git commits onto $svnRemote"
    git branch -f "$tryMerge" "$gitBranch"
    exitIfErr 1 echo "Cannot create branch from $gitBranch"

    git lfs uninstall --local

    local oldHead
    git rebase -s recursive -X theirs \
      --onto "$svnRemote" $mergeBaseSHA1 "$tryMerge" 2> "$tmp/rebase"

    # This loop try to resolve some of the conflict that can be simply 
    # solve - such as:
    # * Removed files from git, but detected modified from SVN
    while [[ $? != 0 ]]; do
      local newHead=`cat .git/rebase-merge/current`

      echo "**** Try to resolve conflict automatically at $newHead"

      if [[ $newHead == $oldHead ]]; then 
        echo "Cannot rebase $gitBranch branch onto of $svnRemote!"
        git rebase --abort
        myExit 1
      fi

      # Conflict "UD" - " unmerged, Deleted by theirs (master)
      # * A file added from SVN but remove by master
      git status --porcelain > "$tmp/gitStatus"
      cat "$tmp/gitStatus"
      sed -ne "s/^UD \(.*\)$/\1/p" "$tmp/gitStatus" \
        | while read f; do git rm "$f"; done


      # Conflict "DU" - " deleted by ours, unmerged
      # * A file may had been exist only in master all along, but now
      # changed - which required to add into SVN
      # * A file added from master, but had been removed by SVN
      sed -ne "s/^DU \(\.git.*\)$/\1/p" "$tmp/gitStatus" \
        | while read f; do git add "$f"; done

      # Handling submodule issues
      sed -ne "s/^M\|UU \(.*\)$/\1/p" "$tmp/gitStatus" \
        | while read f; do \
          if grep -i "= *$f *$" .gitmodules; then \
           git reset -- "$f"; \
          fi; done

      # Code use to debug this process
      #read -p "Check...."

      oldHead=$newHead
      git rebase --continue 2>> "$tmp/rebase"

    done;

    if [[ "$lfsFilter" != "" ]]; then
      echo "****** Remove submodules, and LFS settings"
      git filter-branch -f --tree-filter '
      if [ -f .gitmodules ]; then
        sed -ne "s/^[\t ]*path *= *\(.*\) *$/\1/p" .gitmodules \
          | while read f; do git rm -rf -- "$f"; done
        rm -f .gitmodules
      fi
      rm -f .gitattributes
      git ls-files | while read f; do
        while head -2 "$f" | grep -q "^oid sha256"; do
          ref=$(cat "$f")
          echo -n "$ref" | git lfs smudge > "$f"
          git add "$f"
          >&2 echo remove LFS on "$f"
        done
      done
      ' --prune-empty -- "$svnRemote".."$tryMerge" 2> "$filterLog"
      exitIfErr 1 echo "Cannot remove LFS settings from git commits!" ";" \
        cat "$filterLog"
    else
      echo "****** Remove submodule settings"
      git filter-branch -f --tree-filter '
      if [ -f .gitmodules ]; then
        sed -ne "s/^[\t ]*path *= *\(.*\) *$/\1/p" .gitmodules \
          | while read f; do git rm -rf -- "$f"; done
        rm -f .gitmodules
      fi
      ' --prune-empty -- "$svnRemote".."$tryMerge" 2> "$filterLog"
      exitIfErr 1 echo "Cannot remove submodule settings from git commits!" ";" \
        cat "$filterLog"
    fi

    git lfs install --local

    if [ "$prompt" == "yes" ]; then
      read -p "Check $tryMerge before run dcommit, Press Enter...."
    fi

    echo "****** Do DCommit to push git commits into SVN server"
    echo $svnPwd | git svn dcommit \
      ${dcommitOpt} $tryMerge 2> "$filterLog"
    exitIfErr 1 echo "dcommit failed with following message:" ";" \
      cat "$filterLog" ";" \
      git reset --hard "2>" /dev/null
    #This sometime is dangerous where the error from the git system
    #And may cause mis-calculation for readjustment code later on
    #if [ $? != 0 ]; then
    #  echo ""
    #  echo "WARNING: DCommit failed with following message:"
    #  cat "$filterLog"
    #  echo ""
    #fi

    #TODO: Unlock SVN Folder
    git reset --hard

    echo "****** Figure what were committed into SVN and update the states"
    local newcommitCnt=`git log --oneline "$svnBranch"..$tryMerge | wc -l`
    local commitedCnt=`git log --oneline "$svnBranch"..$svnRemote | wc -l`
    ((uncommitedCnt = newcommitCnt - commitedCnt ))
    echo "There is $uncommitedCnt/$newcommitCnt uncommitted into SVN server"

    if [ "$prompt" == "yes" ]; then
      read -p "Check $svnRemote before update branches.Press Enter...."
    fi

    if [ "$rebaseSync" == "yes" ]; then
      echo "****** Rebase $gitBranch onto $lfsBranch"
      git rebase ${mergeOpt} --onto "$lfsBranch" $mergeBaseSHA1 "$gitBranch"
      exitIfErr 1 echo "Cannot rebase $gitBranch onto $lfsBranch!" ";" \
        git rebase --abort "2>" /dev/null
    fi

    # Re-estimate commits that correct committed into SVN on gitBranch
    git branch -f "$tryLfsMerge" "$gitBranch"\~$uncommitedCnt
    exitIfErr 1 echo "Cannot mark commit wen through SVN on $gitBranch!"

    echo "****** Try to update $lfsBranch and $gitBranch after dcommits"
    git checkout -f "$lfsBranch"
    exitIfErr 1 echo "Cannot checkout $lfsBranch!"

    if [ "$prompt" == "yes" ]; then
      read -p "Check before merge $lfsBranch, Press Enter...."
    fi

    git merge --ff ${mergeOpt} \
      -m "Auto merge $lfsBranch to $gitBranch" "$tryLfsMerge"
    exitIfErr 1 echo "Cannot merge $lfsBranch to $gitBranch!" ";" \
      git merge --abort "2>" /dev/null

    git branch -f "$svnBranch" "$svnRemote"

    if [ "$prompt" == "yes" ]; then
      read -p "Check before rebase $gitBranch, Press Enter...."
    fi

    echo "****** Rebase commits on gitBranch that not get to dcommit"
    git rebase --onto "$lfsBranch" "$tryLfsMerge" "$gitBranch"
    exitIfErr 1 echo "Cannot rebase $gitBranch onto $lfsBranch!" ";" \
      git rebase --abort "2>" /dev/null

    if [ "$prompt" == "yes" ]; then
      read -p "Check before push to stash, Press Enter...."
    fi

    git push -f -u $gitRemote "$lfsBranch"
    exitIfErr 1 echo "Cannot push $lfsBranch to $gitRemote"
  fi

  git push -f -u $gitRemote "$gitBranch"
  exitIfErr 1 echo "Cannot push $gitBranch into $gitRemote"
  #TODO: Unlock $gitBranch

  if [ "$prompt" == "yes" ]; then
    read -p "Check $gitBranch, $lfsBranch, $svnBranch. Press Enter...."
  fi

  echo "****** Remove temporary branches"
  git checkout -f "$svnBranch"
  git branch -D "${tryLfsMerge}" 
  git branch -D "${tryMerge}"   2> /dev/null

  echo "****** Cleanup git report"
  git reflog expire
  git gc

  if [ $uncommitedCnt != 0 ]; then
    run_again=yes
  fi
}

get_gitattributes()
{
  # Capture project specific LFS setting
  git show "$gitBranch:.gitattributes" > "$tmp/.gitattributes" 2> /dev/null
  if [ $? == 0 ]; then
    # Extract all the file matching for LFS
    lfsFilter=`sed -nE \
      "s/\[(.)[^\]]*\]/\1/g; s/^ *([^ ]*)  *filter=lfs .*$/\1/p" \
      "$tmp/.gitattributes" \
              | paste -sd ","`
    local lfsFilterUpper=`echo "$lfsFilter" | tr "[:lower:]" "[:upper:]"`
    local lfsFilterLower=`echo "$lfsFilter" | tr "[:upper:]" "[:lower:]"`
    lfsFilter=${lfsFilterLower},${lfsFilterUpper}

  else

    echo "NOTE: Cannot find .gitattributes from $gitBranch branch!"
    unset lfsFilter
  fi

  if [[ "$lfsFilter" == "" ]]; then
    echo "NOTE: Not use LFS for this repository"
    DBG  "LFS files are: $lfsFilter"
    git lfs uninstall       &> /dev/null
    git lfs install --local 2> /dev/null
  fi
}

get_svnInfo()
{
  # Figure out svn branch, and folder name
  svnRemote=`git config --get svn-remote.svn.fetch`
  if [ "$svnRemote" == "" ]; then
    >&2 echo "Cannot found SVN branch!"
    >&2 echo "Please use --init SVN_FOLDER"
    myExit 1
  fi

  svnRemote="${svnRemote##*/}"
  svnFolder="${svnRemote##*svn-}"
  svnBranch="svn/$svnFolder"
  if [[ "$lfsFilter" != "" ]]; then
    lfsBranch="svn/lfs/$svnFolder"
  else
    lfsBranch="$svnBranch"
  fi

  lfsSHA1=`getSHA1 "$lfsBranch"`
  svnSHA1=`getSHA1 "$svnBranch"`

  DBG "SVN folder label: $svnFolder"
  DBG "SVN branch      : $svnSHA1 - $svnRemote"
  DBG "LFS sync branch : $lfsSHA1 - $lfsBranch"
}

getSvnCommiters()
{
  echo $svnPwd | svn log -q "$svnURL" > "$tmp/svn_log" 2> "$tmp/error"
  if [[ $? != 0 ]]; then 
    >&2 echo "Cannot query SVN log due to following error:"
    >&2 cat "$tmp/error"
    myExit $?; 
  fi

  cat "$tmp/svn_log" \
    | awk -F '|' \
             '/^r/ {sub("^ ", "", $2); sub(" $", "", $2);\
              print $2" = "$2" <"$2">"}' \
    | sort -u > "$authorFile"
  exitIfErr $? echo "Cannot process svn log!"

  echo "PLEASE Fix committer Email in `relPath "$authorFile"` using following form:"
  echo "  svnCommiterID = gitCommiterID <email>"
}

getSHA1()
{
  local sha1=`git log --pretty=oneline -1 "$1"` 2> /dev/null
  exitIfErr 1 echo "Fail to obtain SHA-1 number for branch $1"
  sha1="${sha1%% *}"
  echo "$sha1"
}

getCurBranch()
{
  local branch_name=$(git symbolic-ref -q HEAD)
  branch_name=${branch_name##refs/heads/}
  branch_name=${branch_name:-HEAD}
  echo $branch_name
}

relPath()
{
  echo `realpath --relative-to="$curDir" "$1"`
}

# $1 - Error code
# $2 - Error message
exitIfErr()
{
  if [ ! $? == 0 ]; then
    local error=$1
    shift
    if [[ $# != 0 ]]; then (>&2 eval "$@") fi
    myExit $error
  fi
}

myExit()
{
  cleanUp
  exit $1
}

DBG()
{
  if [ "$dbg" == "yes" ]; then
    local line=`caller`
    line=${line%% *}
    echo "DEBUG:${line:0:4} $@"
  fi
}

main "$@"
