#!/bin/bash
#!/bin/bash -x
scriptDir="$(cd "$(dirname "$BASH_SOURCE")"; pwd -P)"
source "$scriptDir/logging"

showHelp ()
{
  cat <<EOF
`basename "$BASH_SOURCE"` [options]

This script help sync change between SVN and Git repositories.

Options:

  --authors AUTHORS_FILE_LOCATION
      Specify authors files that contain a list of equation
      USER_NAME=USER_EMAIL. (Default $authorFile)

  --gitUrl GIT_URL
      Setting origin remote git URL. (Default $gitURL)

  --ignore-paths <regex>
      Perl regular expression to skipping of all matching pahts. Use for
      with --init. This is the git svn option.

  --init SVN_FOLDER_PATH
      Setting up initial SVN branch for synchronize

  --svnPwd PASSWORD
      Specify svn password.

  --svnUrl SVN_URL
      Setting SVN URL. (Default $svnURL)

  --svnUser USERNAME
      Specify username for svn. (Default $svnUser)

  -b, --branch BRANCH_NAME
      Specify git main branch to sync with SVN. (Default is $gitBranch)

  -d, --debug
      Will show all detail message for debugging the script.

  -e, --email
      Specify email file name to log committer's emails

  -m, --mergeSync
      Use merge to synchronize when svn and git branch as splited.
      (Default)

  -n, --no-svnCommit
      Use to do a dry run dcommit on SVN.

  -p, --prompt
      Will stop a major point and ask for check before continue.

  -r, --rebaseSync
      Use rebase to synchronize when svn and git branch as splited.

  -s, --strategy STRATEGY_NAME
      Specify git merge options. (Default is
      $mergeOpt)

  -u, --use_migrate
      Use lfs migrate when possible. There was a issue with mirgrate, so
      the default is use a work around method to avoid lfs migrate bug

EOF
} # end of showHelp

main ()
{
setDefaultSettings

# Go through all arguments
while [[ ! -z "$1" ]]; do
  if [[ $1 =~ ^-h$|^--help$         ]]; then showHelp; return; fi

  if [[ $1 =~ ^--authors$           ]]; then authorFile=`realpath "$2"`;  shift; shift; continue; fi
  if [[ $1 =~ ^--gitUrl$            ]]; then gitURL="$2";                 shift; shift; continue; fi
  if [[ $1 =~ ^--ignore-paths       ]]; then svnIgnorePaths="$2";         shift; shift; continue; fi
  if [[ $1 =~ ^--init$              ]]; then init=("$2");                 shift; shift; continue; fi
  if [[ $1 =~ ^--svnPwd$            ]]; then svnPwd="$2";                 shift; shift; continue; fi
  if [[ $1 =~ ^--svnUrl$            ]]; then svnURL="$2";                 shift; shift; continue; fi
  if [[ $1 =~ ^--svnUser$           ]]; then svnUser="$2";                shift; shift; continue; fi

  if [[ $1 =~ ^-b$|^--branch$       ]]; then gitBranch="$2";              shift; shift; continue; fi
  if [[ $1 =~ ^-d$|^--debug$        ]]; then LOG_LEVEL=$LOG_LEVEL_DEBUG;  shift;        continue; fi
  if [[ $1 =~ ^-e$|^--email$        ]]; then emailFile=`realpath "$2"`;   shift; shift; continue; fi
  if [[ $1 =~ ^-m$|^--mergeSync$    ]]; then rebaseSync="no";             shift;        continue; fi
  if [[ $1 =~ ^-n$|^--no-svnCommit$ ]]; then dcommitOpt+=("-n");          shift;        continue; fi
  if [[ $1 =~ ^-p$|^--prompt$       ]]; then prompt="yes";                shift;        continue; fi
  if [[ $1 =~ ^-r$|^--rebaseSync$   ]]; then rebaseSync="yes";            shift;        continue; fi
  if [[ $1 =~ ^-s$|^--strategy$     ]]; then mergeOpt="$2";               shift; shift; continue; fi

  if [[ $1 =~ ^-u$|^--use_migrate$  ]]; then use_lfs_migrate="yes";       shift;        continue; fi

  INFO "Unknown argument $1"
  exit 2
done

checkSettings
DBG      "## GIT, AND LFS CONFIGURATION ##"
DBG_EVAL "which git-lfs" "git lfs env"
DBG_EVAL "which git" "git version" "git config --show-origin --list"
DBG "Use temp folder of $tmp"

get_gitattributes
init_fetchNewSvnFolder "${init[@]}"

get_svnInfo
local svnNewSHA="dummy"
local lfsNewSHA="dummy"

while [ "$run_again" != "no" ]; do
  run_again=no
  if [ "$svnNewSHA$lfsNewSHA" == "$svnSHA1$lfsSHA1" ]; then
    INFO "****** No thing was updated Stop the sync loop"
    WARN "You may need to check to correct problem and run sync again"
    break;
  fi

  lfsSHA1=`getSHA1 "$lfsBranch"`
  svnSHA1=`getSHA1 "$svnBranch"`

  DBG "SVN folder label: $svnFolder"
  DBG "SVN branch      : $svnSHA1 - $svnRemote"
  DBG "LFS sync branch : $lfsSHA1 - $lfsBranch"

  syncSVNtoGIT
  syncGITtoSVN

  svnNewSHA=`getSHA1 "$svnBranch"`
  lfsNewSHA=`getSHA1 "$lfsBranch"`
done

INFO "****** Cleanup git report"
git reflog expire
git gc

cleanUp
} # End of main

setDefaultSettings()
{
  curDir="`pwd`"
  myDir="`dirname "$BASH_SOURCE"`"
  tmp="/tmp/`basename $BASH_SOURCE`_`date +%y%m%d_%H%M%S`_$BASHPID"
  emailFile=$tmp/emails
  testdir="$HOME"
  local temp=`cygpath -m "$tmp"`
  if [ $? == 0 ]; then tmp=$temp; fi

  authorFile="../authors-transform.txt"
  rebaseSync="no"
  prompt="no"

  svnURL=
  dcommitOpt=("--rmdir")
  svnAccount=()

  local temp=`git config --local --get svn-remote.svn.url 2> /dev/null`
  if [ $? == 0 ]; then svnURL="`dirname "$temp"`"; fi

  gitURL=
  gitRemote=origin
  gitBranch="master"
  repoDir="$curDir"
  mergeOpt="-s recursive -Xours -Xpatience"
  mergeOpt+=" -Xignore-cr-at-eol -Xignore-space-at-eol"

  temp=`git config --local --get remote.${gitRemote}.url 2> /dev/null`
  if [ $? == 0 ]; then gitURL="${temp}"; fi

  use_lfs_migrate="no"

  init=()
} # End of setDefaultSettings

checkSettings()
{
  mkdir -p "$tmp"
  exitIfErr 1 "Cannot create folder $tmp!"

  # check svn account
  if [ ! -z "$svnPwd" ]; then
    svnAccount=(--username "$svnUser" --password "$svnPwd")
    local errWillbe="Cannot access svn with specified password!"
  elif [ ! -z "$svnUser" ]; then
    svnAccount=(--username "$svnUser")
    local errWillbe="Cannot access svn with specified user without password!"
  else
    local errWillbe="Cannot access to svn without username/password!"
  fi
  if [[ ! -z "$APPDATA" ]]; then
    svnAccount+=(--config-dir "${APPDATA//\\/\/}")
  fi
  printf "\n\n\n\n\n" | svn info "${svnAccount[@]}" "$svnURL" &> "$tmp/error"
  exitIfErr 1 "$errWillbe. svn error:" '
    cat "'"$tmp/error"'"'

  authorFile="`realpath "$authorFile"`"

  # Check of setting correctness
  if [ ! -f "$authorFile" ]; then
    ERROR "authorFile of $authorFile is not found!"
    ERROR "****** Going to extract from SVN log."
    getSvnCommiters
    myExit 1
  fi

  cd "$repoDir"
  exitIfErr 1 "Cannot change to folder $repoDir!"

  local oldSvnUrl=`git config --local --get svn-remote.svn.url 2>/dev/null`
  if [ -z "$svnURL" ]; then
  # Obtain SVN URL from the .git/config if not specified by user
    exitIf '-z "$oldSvnUrl"' 1 "Please specify svn URL"
    svnURL=`dirname "$oldSvnUrl"`

  elif [[ ! "$oldSvnUrl" =~ "$svnURL/"* ]]; then
  # Create rewriteRoot in case $svnURL is not the same
    local oldSvnRewrite=`git config --local \
      --get svn-remote.svn.rewriteRoot 2> /dev/null`
    if [ -z "$oldSvnRewrite" ]; then
      git config --local --replace-all svn-remote.svn.rewriteRoot \
        "${oldSvnUrl// /%20}"
      exitIfErr 1 "Cannot create svn-remote.svn.rewriteRoot"
    fi

    # Try guess the SVN folder by assuming the old and new URL have the
    # same hierarchy level
    local newSvnUrl=$svnURL/
    local svnDir=$oldSvnUrl
    while [ ! -z "$newSvnUrl" ]; do
      newSvnUrl=${newSvnUrl#*/}
      svnDir=${svnDir#*/}
    done

    local newSvnUrl=$svnURL/$svnDir
    git config --local --replace-all svn-remote.svn.url "$newSvnUrl"
    if [[ ! -z "$oldSvnUrl" ]]; then
      NOTE "Move SVN URL to $newSvnUrl from $oldSvnUrl"
    fi
  fi

  if [ -z "$gitURL" ]; then
    local curSvnUrl=`git config --local \
      --get remote.${gitRemote}.url 2>/dev/null`
    exitIfErr 1 "Please specify git URL"
    gitURL="${curSvnUrl}";
  fi

  local status=`git status -s` &> /dev/null
  exitIfErr 1 "$repoDir is not a git folder.\n\
    Please switch to git directory."

  if [[ ! -z "$status" ]]; then
  # Try again with lfs uninstalled
    git lfs uninstall --local 2>/dev/null
    status=`git status -s` &> /dev/null
    exitIfErr 1 "$repoDir is not a git folder.\n\
      Please switch to git directory."
  fi

  if [[ ! -z "$status" ]]; then
    ERROR "The working directory is dirty. Please do a git reset --hard"
    ERROR "Following are files that need to be taking care:"
    ERROR "$status"
    myExit 1
  fi

  filterLog="$tmp/filterLog.log"
}

cleanUp()
{
  if [[ -f "$emailFile" ]]; then
    INFO      "Committers' email:"
    INFO_EVAL "cat \"${emailFile}\""
  fi

  rm -rf "$tmp" 2> /dev/null
  cd "$curDir" 2> /dev/null
}

exitErrInfo()
{
  if [[ $LOG_LEVEL -lt $LOG_LEVEL_DEBUG ]]; then
    INFO      "## GIT, AND LFS CONFIGURATION ##"
    INFO_EVAL "env" "which git-lfs" "git lfs env"
    INFO_EVAL "which git" "git version" "git config --show-origin --list"
  fi
}

init_fetchNewSvnFolder()
# $1 specify SVN path from relative to SVN ROOT
{
  if [ $# == 0 ]; then return; fi

  if [ -z "$1" ]; then
    ERROR "missing SVN_FOLDER_PATH from --init option!".
    myExit 1
  fi

  svnFolder="${1//\//-}"
  svnRemote="svn-${svnFolder// /}"
  svnBranch="svn/${svnFolder// /}"
  lfsBranch="svn/lfs/${svnFolder// /}"

  local curBranch=`getCurBranch`
  if [[ "$curBranch" == "$lfsBranch" ]] || \
     [[ "$curBranch" == "$svnBranch" ]]; then
    git checkout -f "$gitBranch"
    exitIfErr 1 "Cannot switch to $gitBranch branch"
  fi

  git config --local --get remote.${gitRemote}.url
  if [[ $? != 0 ]]; then
    INFO "****** Link ${gitRemote} to ${gitURL}"
    git remote add ${gitRemote} "${gitURL}"
  fi

  INFO "****** Create a svn remote under $svnRemote branch"
  git config --local svn-remote.svn.url   "$svnURL/$1"
  git config --local svn-remote.svn.fetch ":refs/remotes/$svnRemote"
  exitIfErr 1 "Cannot configure remote SVN to $svnURL!"

  if [[ ! -z $svnIgnorePaths ]]; then
    git config --local svn-remote.svn.ignore-paths "$svnIgnorePaths"
  fi
  rm -rf "$repoDir/.git/svn" 2> /dev/null

  git branch -D    "$lfsBranch" 2> /dev/null
  git branch -D    "$svnBranch" 2> /dev/null
  git branch -D -r "$svnRemote" 2> /dev/null

  INFO "****** Fetch SVN into $svnRemote"
  git checkout --orphan "${svnBranch}"
  exitIfErr 1 "Cannot checkout empty orphan branch of $svnRemote!"

  git reset --hard 2> /dev/null
  git lfs uninstall --local 2>/dev/null

  # Send password twice because there was a case where svn asked for
  # password second times if the git-svn layout version not match
  printf "%s\n%s\n%s\n%s\n%s\n" \
    "$svnPwd" "$svnPwd" "$svnPwd" "$svnPwd" "$svnPwd" | \
    git svn fetch --username "$svnUser" -A "$authorFile" 2> "$filterLog"
  exitIfErr 1 "Cannot fetch commits from SVN \\($svnURL\\)! due to:" '
    cat "'$filterLog'"'

  git checkout -f "$svnBranch"
  exitIfErr 1 "SVN folder may not existed (cannot switch to $svnBranch):" '
    cat "'$filterLog'"'
  git reset --hard

  INFO "****** Create new branch $lfsBranch"
  # NOTE: git branch command some time fail for the 1st run while operate
  # under mapped network drive
  retry 4 git branch "$lfsBranch" "$svnRemote"
  exitIfErr 1 "Cannot create $lfsBranch branch"

  if [[ ! -z "$lfsFilter" ]]; then
    INFO "****** Rebase SVN commits with lfs settings"
    # This WORKAROUND help git lfs migrate work more effective
    if [[ "$use_lfs_migrate"=="no" ]]; then
      git filter-branch --prune-empty -f --index-filter '
        cp "'${tmp}'"/.git* .
        git add .git*
        ' -- "${lfsBranch}" 2> "$filterLog"
      exitIf "$? != 0 && $? != 2" $? \
        "Failed to apply LFS settings to $lfsBranch! due to:" '
        cat "'$filterLog'"'

      git lfs install --local
      git lfs migrate import --fixup "$lfsBranch"
    else
      git lfs install --local
      git lfs migrate import --include="$lfsFilter" "$lfsBranch"
    fi

    exitIfErr 1 "Failed to migrate to LFS"

    git update-ref -d "refs/original/refs/heads/$lfsBranch"
  fi

  local backupBranch="backup/${gitBranch}_`date +%y%m%d_%H%M%S`"
  retry 4 git branch -f "$backupBranch" "$gitBranch"
  if [ $? == 0 ]; then
    INFO "****** Backup $gitBranch branch to $backupBranch"
  fi

  INFO "****** Set $gitBranch branch to $lfsBranch";
  retry 4 git branch -f "$gitBranch" "$lfsBranch"
  exitIfErr 1 "Cannot set $gitBranch to $lfsBranch"

  retry 4 git push "$gitRemote" -u -f "$lfsBranch" "$gitBranch"
  exitIfErr 1 "Cannot push $lfsBranch and/or $gitBranch into $gitRemote"

}

# @return error code non-zero if there no thing to sync
syncSVNtoGIT()
{
  INFO "****** Fetch new commits from SVN to $svnRemote"
  local svnOldSHA1=`getSHA1 "$svnRemote"`
  printf "%s\n" "$svnPwd" | \
    git svn fetch --username "$svnUser" \
    -A "$authorFile" 2> "$filterLog"
  exitIfErr 1 "Cannot fetch commits from SVN \\($svnURL\\)! due to:" '
    cat "'$filterLog'"'
  local svnNewSHA1=`getSHA1 "$svnRemote"`
  DBG "New SHA-1 for $svnRemote: $svnNewSHA1"

  if [[ $svnOldSHA1 == $svnNewSHA1 ]]; then
    INFO "Make sure $lfsBranch sync with the server"
    retry 4 git push "$gitRemote" -u -f "$lfsBranch"
    exitIfErr 1 "Cannot push $lfsBranch to $gitRemote"

    INFO "No new SVN commits to work on."
    return 1
  fi

  INFO "###### Sync SVN commits to GIT ######"
  git checkout -f "$svnBranch"
  exitIfErr 1 "Cannot checkout $svnBranch."

  # Rebase SVN changed into LFS (SVN changed = theirs)
  INFO "****** Put new SVN commits ${svnSHA1:0:8}..${svnNewSHA1:0:8} \
    onto $lfsBranch"

  local tryLfsMerge="try/lfs/fromSVN"
  retry 4 git branch -f "$tryLfsMerge" "$svnRemote"
  exitIfErr 1 "Cannot create a temporary branch $tryLfsMerge"

  # Extract list of committers' email
  git log --pretty=format:%ce $svnSHA1..$svnNewSHA1 | sort -u >> "${emailFile}"

  if [[ ! -z "$lfsFilter" ]]; then
    INFO "** Apply LFS setting on new SVN commits on $svnRemote"

    INFO "Repair, and find new binary file for apply LFS"
    git filter-branch --prune-empty -f --index-filter '
      cp "'"${tmp}"'/.gitattributes" .gitattributes
      git diff "'${svnBranch}'" --cached --name-only --diff-filter=ACR \
        | while read f; do
          git check-attr filter "$f" | grep "filter: unspecified$" >/dev/null
          if [ $? != 0 ]; then continue; fi

          git checkout-index -f -- "$f"
          echo "$f" | perl -lne "exit 1 if -B"
          if [ $? == 0 ]; then continue; fi

          printf "\r"
          git lfs track "$f"
        done

      git add .gitattributes
      cp .gitattributes "'"${tmp}"'/.gitattributes"
      ' -- "${svnBranch}".."${tryLfsMerge}" 2> "$filterLog"
    exitIf "$? != 0 && $? != 2" $? \
      "Cannot apply LFS setting on new SVN commits!" '
      cat "'$filterLog'"'

    if [ "$prompt" == "yes" ]; then
      read -p "Check if .gitattributes up-date correctly for new LFS files..."
    fi

    INFO "Migrate SVN commit to LFS"
    # It is often filter-branch along is not enough to convert file into
    # LFS - seem like file that modified are the once did not converted
    # into LFS - Use git lfs migrate to help WORKAROUND this issue.
    git lfs migrate import  \
      --fixup \
      --exclude-ref="${svnBranch}" \
      --include-ref="${tryLfsMerge}"
    exitIfErr 1 "Failed to run lfs migrate on new SVN commits"

    if [ "$prompt" == "yes" ]; then
      read -p "Check if migrate still not converted all LFS..."
    fi
  fi

  INFO "Now rebase onto $lfsBranch"
  local oldHead='a'
  local newHead=''
  git rebase -s recursive -X theirs \
    --onto "$lfsBranch" "$svnBranch" "$tryLfsMerge"

  # This loop try to resolve some of the conflict that can be simply
  # solve - such as:
  # * Removed files from git, but detected modified from SVN
  while [[ $? != 0 ]]; do
    newHead=`git log REBASE_HEAD -1 --format=%H 2>/dev/null` \
    || newHead=`cat .git/rebase-merge/stopped-sha 2>/dev/null` \
    || newHead=`cat .git/rebase-merge/orig-head` \

    INFO "**** Try to resolve conflict automatically at $newHead"

    if [[ $newHead == $oldHead ]]; then
      ERROR "Cannot apply new SVN commit onto $lfsBranch!"
      if [ "$prompt" == "yes" ]; then
        read -p "Check why rebase is failed..."
      fi
      git rebase --abort
      myExit 1
    fi

    git status --porcelain > "$tmp/gitStatus"
    cat "$tmp/gitStatus"

    # Conflict ".D"
    # * A file deleted from svn
    sed -ne "s/^.D \(.*\)$/\1/p" "$tmp/gitStatus" \
      | while read f; do git rm -f "$f"; done

    # Code use to debug this process
    if [ "$prompt" == "yes" ]; then
      read -p "Check...."
    fi

    oldHead=$newHead
    git rebase --continue 2>> "$tmp/rebase"
  done;

  git filter-branch --env-filter '
    export GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME
    export GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
    export GIT_COMMITTER_DATE=$GIT_AUTHOR_DATE
  ' -f -- "$lfsBranch".."$tryLfsMerge"
  exitIf "$? != 0 && $? != 2" $? \
    "Cannot readjust committer info onto $tryLfsMerge!"

  retry 4 git branch -f "$lfsBranch"
  exitIfErr 1 "Cannot move $lfsBranch to new rebase tip!"
  local lfsNewSHA1=`getSHA1 "$lfsBranch"`
  DBG "New SHA-1 for $lfsBranch: $lfsNewSHA1"

  INFO "*** Go back to $svnBranch after rebase"
  git checkout -f -B "$svnBranch" "$svnRemote"
  exitIfErr 1 "Cannot switch and move $svnBranch to $svnRemote"
  git reset --hard

  git branch -D "${tryLfsMerge}" 2> /dev/null

  if [ "$prompt" == "yes" ]; then
    read -p "Check before push result into server...."
  fi

  retry 4 git push "$gitRemote" -u -f "$lfsBranch"
  exitIfErr 1 "Cannot push $lfsBranch to $gitRemote"
}

#
# Adjust the difference between Git master branch and SVN
#
# @return error code non-zero if there is a problem
# @return $run_again=yes if the error may resolve by rerun this function
adjGitBranch()
{
  INFO "###### Adj GIT on top of SVN ######"
  git checkout -f "$svnBranch"
  exitIfErr 1 "Cannot checkout $svnBranch."

  INFO "***** Update $gitBranch from git server"
  retry 4 git fetch $gitRemote "$gitBranch"
  exitIfErr 1 "Cannot pull $gitBranch from $gitRemote"

  retry 4 git branch -f "$gitBranch" "$gitRemote/$gitBranch"
  exitIfErr 1 "Cannot link $gitBranch with $gitRemote"

  local gitSHA=`getSHA1 "$gitBranch"`
  local lfsSHA=`getSHA1 "$lfsBranch"`
  if [ $gitSHA == $lfsSHA ]; then
    INFO "Nothing to be syn."
    return 1;
  fi

  local mergeBaseSHA1=`git merge-base "$gitBranch" "$lfsBranch"`
  if [ -z "$mergeBaseSHA1" ]; then
    ERROR "$gitBranch and $lfsBranch don't have common ancestor!."
    myExit 1
  fi
  INFO "$mergeBaseSHA1 is common ancestor of $gitBranch and $lfsBranch"

  # Extract list of committers' email
  git log --pretty=format:%ce $mergeBaseSHA1.."$gitBranch" >> "${emailFile}"
  git log --pretty=format:%ce $mergeBaseSHA1.."$lfsBranch" >> "${emailFile}"

  if [ $lfsSHA == $mergeBaseSHA1 ]; then
    #      -- <--lfsBranch
    #     /
    # *--*--* <--gitBranch
    return;
  fi

  if [ $gitSHA == $mergeBaseSHA1 ]; then
    #      -- <--gitBranch
    #     /
    # *--*--* <--lfsBranch
    INFO "****** Fast-forward $gitBranch to $lfsBranch"
    retry 4 git branch -f "$gitBranch" "$lfsBranch"
    exitIfErr 1 "Cannot fast forward $gitBranch to $lfsBranch"

  else
    #       *--* <--gitBranch
    #     /
    # *--*--*--* <--lfsBranch
    #     \
    #      ----- <--mergeBaseSHA1
    #
    if [ "$rebaseSync" != "yes" ]; then return; fi

    INFO "****** Rebase $gitBranch onto $lfsBranch"
    git rebase ${mergeOpt} \
      --onto "$lfsBranch" $mergeBaseSHA1 "$gitBranch"
    exitIfErr 1 "Cannot rebase $gitBranch onto $lfsBranch!" '
      git rebase --abort 2>/dev/null'

    git filter-branch --env-filter '
      export GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME
      export GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
      export GIT_COMMITTER_DATE=$GIT_AUTHOR_DATE
    ' -f -- "$lfsBranch".."$gitBranch"
    exitIf "$? != 0 && $? != 2" $? \
      "Cannot readjust committer info onto $gitBranch!"
  fi

  if [[ -f $testdir/.SYNC_TEST_MASTER_CHANGE_WHILE_REBASE ]]; then
    source $testdir/.SYNC_TEST_MASTER_CHANGE_WHILE_REBASE
  fi
  retry 4 git push "$gitRemote" -u --force-with-lease "$gitBranch"
  if [[ $? != 0 ]]; then
    WARN "Cannot push $gitBranch. It Ok, if it had changed on remote."
    WARN "Going to try again..."
    run_again=yes
    return 1
  fi
}

syncGITtoSVN()
{
  adjGitBranch || return

  INFO "###### Sync GIT commits to SVN ######"
  #      -- <--lfsBranch
  #     /
  # *--*--* <--gitBranch
  INFO "****** Put new git commits onto $svnRemote"
  local tryMerge="try/merge"
  retry 4 git branch -f "$tryMerge" "$gitBranch"
  exitIfErr 1 "Cannot create branch from $gitBranch"

  echo '
    rm -f "'"$tmp\rebaseWorkAmend"'"
    find . -iname ".gitmodules" -type f | while read ff; do
      pushd "`dirname "$ff"`"
      sed -ne "s/^[\t ]*path *= *\(.*\) *$/\1/p" .gitmodules \
        | while read f; do
          rm -rf "$f"
          git add -v "$f"
        done
      echo >"'"$tmp\rebaseWorkAmend"'"
      popd
    done

    find . -type f -iname ".git*" ! -iname ".gitmodules" \
      | while read ff; do
        git rm -f "$ff"
        echo >"'"$tmp\rebaseWorkAmend"'"
      done
  ' > "$tmp/rebaseWork"

  if [[ ! -z "$lfsFilter" ]]; then
    git lfs uninstall --local 2>/dev/null
    echo '
      git diff "'"$svnRemote"'" --cached \
        --name-only --diff-filter=d > "'"$tmp\rebaseWorkDiff"'"
      git diff "'"$svnRemote"'" HEAD~1 \
        --name-only --diff-filter=d >> "'"$tmp\rebaseWorkDiff"'"
      cat "'"$tmp\rebaseWorkDiff"'" \
        | while read f; do
        head -2 "$f" | sed -ne "s/^oid sha256:\([^ ]*\)/\1/p" \
          | while read ref; do
          ref="'"$tmp"'/lfs-$ref"
          if [ ! -f "$ref" ]; then
            cat "$f" | git lfs smudge > "$ref"
            if [ $? != 0 ]; then
              rm -f "$ref"
              >&2 printf "\n  Cannot remove LFS pointer for $f\n"
              exit 3
            fi
            printf "\n  Remove LFS pointer on $f\n"
          fi
          cp -f "$ref" "$f"
          git add "$f"
          echo >"'"$tmp\rebaseWorkAmend"'"
          break
        done
      done
    ' >> "$tmp/rebaseWork"
  fi

  echo '
    if [[ -f "'"$tmp\rebaseWorkAmend"'" ]]; then
      git commit --amend --allow-empty -C HEAD

      # Code use to debug this process
      if [ "'$prompt'" == "yes" ]; then
        printf "Check before continue rebase...."
        read
      fi
    fi
  ' >> "$tmp/rebaseWork"

  local oldHead='a'
  local newHead=''
  local maxWarnCnt=10
  # WARNING: This rebase process may skip some commits
  git rebase -s recursive -X theirs --exec "source \"$tmp/rebaseWork\""\
    --onto "$svnRemote" "$lfsBranch" "$tryMerge" 2> "$tmp/rebase"

  # This loop try to resolve some of the conflict that can be simply
  # solve - such as:
  # * Removed files from git, but detected modified from SVN
  while [[ $? != 0 ]]; do
    newHead=`git log REBASE_HEAD -1 --format=%H 2>/dev/null` \
    || newHead=`cat .git/rebase-merge/stopped-sha 2>/dev/null` \
    || newHead=`cat .git/rebase-merge/orig-head` \

    INFO "**** Try to resolve conflict automatically at $newHead"

    if [[ $newHead == $oldHead ]]; then
      if [[ $maxWarnCnt -ne 0 ]]; then
        DBG_EVAL 'cat "$tmp/rebase"'
        WARN "Resolve same SHA-1 again!"
        ((maxWarnCnt=maxWarnCnt-1))
      else
        ERROR "Cannot rebase $gitBranch branch onto of $svnRemote!"
        if [ "$prompt" == "yes" ]; then
          read -p "Check why rebase is failed..."
        fi
        [[ "$lfsFilter" ]] && git lfs install --local
        git rebase --abort
        myExit 1
      fi
    fi

    git status --porcelain > "$tmp/gitStatus"
    cat "$tmp/gitStatus"

    rm -f "$tmp\rebaseWorkAmend"
    # Conflict "*D" - " Deleted by theirs (master)
    # * A file added from SVN but remove by master
    sed -ne "s/^.D \(.*\)$/\1/p" "$tmp/gitStatus" \
      | while read f; do
        rm -f "$f"
        git add -v "$f"
        echo >"$tmp\rebaseWorkAmend"
      done

    # Handle some cases where the item were submodule and had been
    # excluded or deleted from SVN branches
    sed -ne "s/^D. \(.*\)$/\1/p" "$tmp/gitStatus" \
      | while read f; do
        # Obtain the item type
        local type=`git ls-tree $newHead -- "$f" \
          | sed -En "s/[^ ]+ ([^ ]+).*/\1/p"`

        if [[ "$type" == "commit" ]]; then
        # commit type usually is a submodule folder, so we discard it
          rm -f "$f"
        else
          git checkout $newHead -- "$f"
        fi
        git add -v "$f"
        echo >"$tmp\rebaseWorkAmend"
      done

    # Take any other changes from master
    sed -ne "s/^[^D][^D] \(.*\)$/\1/p" "$tmp/gitStatus" \
      | while read f; do
      git checkout $newHead -- "$f"
      git add -v "$f"
      echo >"$tmp\rebaseWorkAmend"
    done

    if [[ -f "$tmp\rebaseWorkAmend" ]]; then
      git commit -C $newHead
    fi

    # Code use to debug this process
    if [ "$prompt" == "yes" ]; then
      read -p "Check...."
    fi

    oldHead=$newHead
    git rebase --continue 2>> "$tmp/rebase"

  done;

  git filter-branch --env-filter '
    export GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME
    export GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
    export GIT_COMMITTER_DATE=$GIT_AUTHOR_DATE
  ' --index-filter '
    git ls-files --cached --full-name | grep -e "^\(.*/\)\?.gitmodules$" \
      | while read f; do
        git rm --cached -f "$f"
      done
  ' --prune-empty -f -- "$svnRemote".."$tryMerge"
  exitIf "$? != 0 && $? != 2" $? \
    "Cannot readjust committer info onto $tryMerge!" '
    [[ "$lfsFilter" ]] && git lfs install --local'

  [[ "$lfsFilter" ]] && git lfs install --local

  if [ "$prompt" == "yes" ]; then
    read -p "Check $tryMerge before run dcommit, Press Enter...."
  fi

  if [[ -f $testdir/.SYNC_TEST_SVN_CHANGE ]]; then
    source $testdir/.SYNC_TEST_SVN_CHANGE
  fi
  INFO "**** Check make sure no new SVN commit ***"
  syncSVNtoGIT && run_again=true && return

  INFO "****** Do DCommit to push git commits into SVN server"
  if [[ -f $testdir/.SYNC_TEST_SVN_CHANGE_WHILE_DCOMMIT ]]; then
    source $testdir/.SYNC_TEST_SVN_CHANGE_WHILE_DCOMMIT
  fi
  local newCommitCnt=`git rev-list --count "$svnBranch"..$tryMerge`
  printf "%s\n" "$svnPwd" | \
    git svn dcommit --username "$svnUser" \
    --use-log-author --add-author-from \
    "${dcommitOpt[@]}" $tryMerge 2> "$filterLog"
  exitIfErr 1 "dcommit failed with following message:" '
    cat "'$filterLog'"
    git reset --hard 2>/dev/null'

  INFO "****** Figure what were committed into SVN and update the states"
  local  committedCnt=`git rev-list --count "$svnBranch".."$svnRemote"`
  local uncommittedCnt=0
  ((uncommittedCnt = newCommitCnt - committedCnt ))
  INFO "There is $committedCnt/$newCommitCnt committed into SVN server"

  if [ "$prompt" == "yes" ]; then
    read -p "Check $svnRemote before update branches.Press Enter...."
  fi

  INFO "****** Try to update $lfsBranch and $gitBranch after dcommits"

  if [[ $uncommittedCnt != 0 ]]; then
    if [[ $committedCnt != 0 ]]; then
      # What IFF dcommit introducing new commits from SVN? How to migrate
      # these commits into lfsBranch before update lfsBranch.  It rarely
      # occurred because we run syncSVNtoGIT before this.
      ERROR "UNABLE TO HANDLE dcommit that mix with new SVN commits"
      myExit 1
    fi

    local newGitCommitCnt=`git rev-list --count "$lfsBranch".."$gitBranch"`
    if [[ $newGitCommitCnt != $newCommitCnt ]]; then
      # What IFF earlier rebase prune-empty commits, and number of
      # uncommittedCnt is not zero. It is impossible to figure out which
      # commits on master are committed into SVN.
      ERROR "UNABLE TO HANDLED dcommit with some pruned from $gitBranch"
      myExit 1
    fi

    run_again=yes
  fi

  # Re-estimate commits that correct committed into SVN on gitBranch
  local tryLfsMerge="try/lfs/merge"
  retry 4 git branch -f "$tryLfsMerge" "$gitBranch"\~$uncommittedCnt
  exitIfErr 1 "Cannot mark commits on $gitBranch that committed into SVN"

  if [ "$prompt" == "yes" ]; then
    git log --oneline --graph --simplify-by-decoration \
      "$gitBranch" "$lfsBranch" "$svnBranch"
    read -p "Check before merge $lfsBranch, Press Enter...."
  fi

  git checkout -f "$tryLfsMerge"
  exitIfErr 1 "Cannot checkout $tryLfsMerge"

  if [ "$rebaseSync" != "yes" ]; then
    INFO "***** Merge $gitBranch and $lfsBranch"
    git merge --ff ${mergeOpt} \
      -m "Auto merge $lfsBranch to $gitBranch" "$lfsBranch"
    exitIfErr 1 "Cannot merge $lfsBranch to $gitBranch!" '
      git merge --abort 2>/dev/null'

    retry 4 git branch -f "$gitBranch" "$tryLfsMerge"
    exitIfErr 1 "Cannot unify $gitBranch and $lfsBranch branches"
  fi

  retry 4 git branch -f "$lfsBranch" "$tryLfsMerge"
  exitIfErr 1 "Cannot fast-forward $lfsBranch!"

  retry 4 git branch -f "$svnBranch" "$svnRemote"
  exitIfErr 1 "Cannot fast-forward $svnBranch!"

  if [ "$prompt" == "yes" ]; then
    git log --oneline --graph --simplify-by-decoration \
      "$gitBranch" "$lfsBranch" "$svnBranch"
    read -p "Check $gitBranch, $lfsBranch, $svnBranch before push. Press Enter...."
  fi

  if [[ -f $testdir/.SYNC_TEST_MASTER_CHANGE_WHILE_MERGE ]]; then
    source $testdir/.SYNC_TEST_MASTER_CHANGE_WHILE_MERGE
  fi
  retry 4 git push $gitRemote -u -f "$lfsBranch"
  exitIfErr 1 "Cannot push $lfsBranch to $gitRemote"

  retry 4 git push $gitRemote -u "$gitBranch"
  if [[ $? != 0 ]]; then
    WARN "Cannot push $gitBranch. It Ok if it had changed on remote."
    WARN "Going to try again..."
    run_again=yes
  fi

  INFO "****** Remove temporary branches"
  git checkout -f "$svnBranch"
  git branch -D "${tryLfsMerge}" 2> /dev/null
  git branch -D "${tryMerge}"   2> /dev/null
}

get_gitattributes()
{
  # Capture current .git setting files
  rm -f "${tmp}/.git"*
  cp .git* "${tmp}" 2> /dev/null

  # Capture project specific LFS setting
  git show "$gitBranch:.gitattributes" > "$tmp/.gitattributes" 2> /dev/null
  if [ $? == 0 ]; then
    # Extract all the file matching for LFS
    lfsFilter=`sed -nE \
      "s/^ *([^ ]*)  *filter=lfs .*$/\1/p" \
      "$tmp/.gitattributes" \
      | paste -sd ","`

  else

    DBG "No .gitattributes from $gitBranch branch!"
    unset lfsFilter
  fi

  git lfs uninstall --local 2> /dev/null

  # Verify all the lfs filter are uninstalled
  git config --show-origin --get-regexp "filter\.lfs\.(smudge|process)" \
    >"$tmp/lfsSettings" 2>/dev/null
  exitIf "$? == 0" 1 \
    "LFS need to be manually uninstalled in all level except local once" '
    echo "Following configuration need to be remove:"
    cat "$tmp/lfsSettings"
    '

  if [[ -z "$lfsFilter" ]]; then
    NOTE "Not use LFS for this repository"
  else
    DBG  "LFS files are: $lfsFilter"
    git lfs install --local 2> /dev/null
    exitIfErr 1 "Cannot install LFS locally"
  fi
}

get_svnInfo()
{
  # Figure out svn branch, and folder name
  svnRemote=`git config --local --get svn-remote.svn.fetch`
  if [ -z "$svnRemote" ]; then
    ERROR "Cannot found SVN branch!"
    ERROR "Please use --init SVN_FOLDER"
    myExit 1
  fi

  svnRemote="${svnRemote##*/}"
  svnFolder="${svnRemote##*svn-}"
  svnBranch="svn/$svnFolder"
  lfsBranch="svn/lfs/$svnFolder"
}

getSvnCommiters()
{
  printf "\n\n\n\n\n" | svn log "${svnAccount[@]}" -q "$svnURL" \
    >"$tmp/svn_log" 2>"$tmp/error"
  exitIfErr 1 "Cannot query SVN log due to following error:" '
    cat "'$tmp'/error"'

  cat "$tmp/svn_log" \
    | awk -F '|' \
             '/^r/ {sub("^ ", "", $2); sub(" $", "", $2);\
              printf "%s = %s <%s>\n" "$2" "$2" "$2"}' \
    | sort -u > "$authorFile"
  exitIfErr $? "Cannot process svn log!"

  INFO "PLEASE Fix committer Email in $authorFile using following form:"
  INFO "  svnCommiterID = gitCommiterID <email>"
}

getSHA1()
{
  local sha1=`git log --pretty=oneline -1 "$1"` 2> /dev/null
  exitIfErr 1 "Fail to obtain SHA-1 number for branch $1"
  sha1="${sha1%% *}"
  echo "$sha1"
}

getCurBranch()
{
  local branch_name=$(git symbolic-ref -q HEAD)
  branch_name=${branch_name##refs/heads/}
  branch_name=${branch_name:-HEAD}
  echo $branch_name
}

retry()
{
  local cnt=$1
  shift;

  local tryCnt=0
  while [[ $tryCnt -lt $cnt ]]; do
    ((tryCnt+=1))
    if [[ $tryCnt -gt 1 ]]; then
      WARN "Try #$tryCnt -- make sure previous fail aren't real"
      sleep 1
    fi

    "$@"
    local error=$?
    if [[ $error -eq 0 ]]; then return; fi
  done
  (exit $error)
}

relPath()
{
  echo `realpath --relative-to="$curDir" "$1"`
}

myExit()
{
  cleanUp
  if [[ $1 != 0 ]]; then exitErrInfo; fi
  exit $1
}

INFO "Started on `date`"
EXIT_CMDS=(cleanUp exitErrInfo)
main "$@"

