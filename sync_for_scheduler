#!/bin/bash
# This script will be called by scheduler for sync up SVN folder with git
# repository.
#
scriptDir="$(cd "$(dirname "$BASH_SOURCE")"; pwd -P)"
source "$scriptDir/logging"
source "$scriptDir/utils"

showHelp () 
{
  cat <<EOF
`basename "$BASH_SOURCE"` [options] [Sync_Script_Options] [{REPOS_NAME}]

This script should be called by scheduler to sync change between SVN and Git 
repositories.

Options:

  -h, --help
    Show this message.

  --noflock
    Don't use flock - to avoid error for some system.

  -f, --force
      Force sync to remove run had failed log file, and continue run sync.

  -t, --threads N_MAX_THREADS
      Specifiy maximum number of thread run at one time. (Default $max_threads)

  -v, --verbose
      Will show all the log message on output stream

  -g, --gitDir GITS_PATH
      Specifiy where all the synch git repositories location. 
      (Default $gits)

  -l, --logDir LOG_DIR
    Specify where to storage all the log files 

Sync_Script_Options:
  NOTE: Use full option names for passing value, use short option names for
  not required passing value
EOF
"$sync" -h
} # end of showHelp

main()
{
  setDefaultSettings
  error_files=()

  # Go through all arguments
  while [[ ! -z "$1" ]]; do
    if [[ $1 =~ ^-h$|^--help$    ]]; then showHelp;  return; fi

    if [[ $1 =~ ^--noflock$      ]]; then flock='no';                           shift;        continue; fi
    if [[ $1 =~ ^-f$|^--force$   ]]; then force="yes";                          shift;        continue; fi
    if [[ $1 =~ ^-t$|^--threads$ ]]; then max_threads=$2;                       shift; shift; continue; fi
    if [[ $1 =~ ^-v$|^--verbose$ ]]; then veb="yes";                            shift;        continue; fi

    if [[ $1 =~ ^-g$|^--gitDir$  ]]; then gits=`realpath "$2"`;                 shift; shift; continue; fi
    if [[ $1 =~ ^-l$|^--logDir$  ]]; then logDir=`realpath "$2"`;               shift; shift; continue; fi 

    # These are Sync Options
    if [[ $1 =~ ^--[a-zA-Z].*$   ]]; then syncOps+=("$1" "`tryRealPath "$2"`"); shift; shift; continue; fi
    if [[ $1 =~ ^-[a-zA-Z]*$     ]]; then syncOps+=("$1");                      shift;        continue; fi

    repos+=("$1"); shift;
  done
  checkSettings

  if [[ -z $repos ]]; then
    # Sync all repository folders in $gits
    INFO "Sync all repositories in $gits"
    ls "$gits" -1 > "$respoNames" || exit $?
    while IFS= read -r f; do 
      if [ -d "$gits/$f" ]; then repos+=("$f"); fi
    done < "$respoNames"
  fi

  for f in "${repos[@]}"; do 
    waitNThreads "$logDir/" "/lock" "$max_threads" " on $f"
    syncASvnFolder "$f" 
  done

  # Wait for all the sync process finished
  wait
  sleep 1

  # Check weather any error occurred
  for err in "${error_files[@]}"; do
    if [ -f "$err" ]; then echo $err >> "$logDir/tmp_$logFile"; fi
  done
  exitIf '-f "$logDir/tmp_$logFile"' 1 \
    "One or more following repositories failed to sync:" '
    cat "$logDir/tmp_$logFile" | sed -e "s/^/  /"
    echo "PLEASE CHECK ALL THE ERROR LOG FILES."
    echo "REMOVE ERROR LOG FILES TO ALLOWS NEXT SCRIPT RUN NORMALLY."
  '

  INFO "DONE: Everything when fine"
  exitClean
}

# This function call sync script on specified git repository
syncASvnFolder()
{
  # Extract function parameters
  local repoName=$1

  local name="              $repoName"
  name="[${name: -15}]"
  local repoLogDir="$logDir/$repoName"
  local errPath="$repoLogDir/error.log"
  local lock="$gits/$repoName.lock"

  error_files+=("$errPath")

  if [[ "$force" != "yes" ]]; then
    if [[ -f "$errPath" ]]; then
      ERROR "Detected that previous run failed.
      Please check and remove $errPath files"
      return
    fi

    if [[ "$flock" != "yes" && -f "$lock" ]]; then 
      ERROR "Some thread may still running. 
      Please wait or remove ${lock}"
      return
    fi
  fi

  mkdir -p "$repoLogDir"
  echo > "$repoLogDir/$logFile"
  (
    EXIT_CMDS=()
    if [[ "$flock" == "yes" ]]; then flock -n 9; fi
    exitIfErr 0 "Previous run is still running. 
    If not, please remove $lock files"
    EXIT_CMDS=("rm -f \"$lock\" 2>/dev/null")

    INFO "+++++++++ Sync $repoName ($logFile) ..."

    if [[ -f "$errPath" && "$force" == "yes" ]]; then
      WARN "Removing previous run failed log $errPath"
      rm -f "$errPath"
    fi

    rm -f "$repoLogDir/errCode"
    ( 
      LOG_PREFIX=("${LOG_PREFIX[@]:1}")
      (
        pushd "$gits/$repoName"
        "$sync" "${syncOps[@]}" || exit $?
        popd
      ) || echo $? > "$repoLogDir/errCode"
    ) 2>&1 | while IFS= read -r line; do
      echo "$line" >> "$repoLogDir/$logFile";
      if [ "$veb" == "yes" ]; then
        echo "$name ${line//$'\r'/}"
      fi
    done

    exitIf '-f "$repoLogDir/errCode"' 1 \
      "+++++++++ Sync $repoName ($logFile) failed." \
      'ln -sf "$repoLogDir/$logFile" "$errPath"'

    if [[ "$logMaxAge" ]]; then
      INFO "Cleanup log files older than $logMaxAge days..."
      find "$repoLogDir" -type f -atime +$logMaxAge -exec rm -v {} \; 
    fi

    INFO "+++++++++ Sync $repoName ($logFile) finished."
    exitClean 0
  ) 9>"$lock" &
}

cleanUp()
{
  INFO "Cleaning up..."
  rm -f "$respoNames" &>/dev/null
  rm -f "$logDir/tmp_$logFile" &>/dev/null
}

setDefaultSettings()
{
  sync="${scriptDir}/sync"

  # Set default temp folder
  logFile="`basename $BASH_SOURCE`_`date +%y%m%d_%H%M%S`_$BASHPID.log"
  logDir="/tmp"

  max_threads=5
  flock="yes"

  # Specify location of all local git repository path
  gits="${scriptDir}/../cached_repos"

  syncOps=()
  repos=()
  logMaxAge=180
}

checkSettings()
{
  logDir="$logDir/`basename "$scriptDir"`"
  local temp=`cygpath -m "$logDir"`
  if [ $? == 0 ]; then logDir=$temp; fi

  respoNames="$logDir/respoNames_$BASHPID"
}

LOG_PREFIX=("[---------------]" "${LOG_PREFIX[@]}")
EXIT_CMDS=(cleanUp)
main "$@"
