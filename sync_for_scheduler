#!/bin/bash
# This script will be called by scheduler for sync up SVN folder with git
# repository.
#

# Specify location of sync script
scriptDir="$(cd "$(dirname "$0")"; pwd -P)"
sync="${scriptDir}/sync"

# Specify location of all local git repository path
gits="$(dirname "${scriptDir}")/cached_repos"

showHelp () 
{
  cat <<EOF
`basename "$0"` [options] [Sync_Script_Options]

This script should be called by scheduler to sync change between SVN and Git 
repositories.

Options:

  -h, --help
    Show this message.

  -v, --verbose
      Will show all the log message on output stream

  -g, --gitdir
      Specifiy where all the synch git repositories location. 
      (Default $gits)

Sync_Script_Options:
EOF
"$sync" -h
} # end of showHelp

main()
{
  setDefaultSettings

  # Go through all arguments
  while [[ "$1" != "" ]]; do
    if [[ $1 =~ ^-h|--help$ ]]; then showHelp; return; fi
    if [[ $1 =~ ^-v|--verbose$ ]]; then veb="yes"; shift; continue; fi
    if [[ $1 =~ ^-g|--gitdir$ ]]; then gits=$2; shift; shift; continue; fi
    break;
  done

  # Capture the rest of argument for us in sync script
  syncParam=( "$@" )

  # Sync all repository folders in $gits
  echo "Sync all repositories in $gits"
  ls "$gits" -1 > "$respoNames"
  while read f; do 
    if [ -d "$gits/$f" ]; then 
      syncASvnFolder "$f" 
    fi 
  done < "$respoNames"
  rm -f "$respoNames"

  # Wait for all the sync process finished
  wait
  sleep 1

  # Check weather any error occurred
  ls -1 "$logDir"/*/error.log &> "$logDir/tmp_$logFile"
  if [ $? == 2 ]; then
    echo "DONE: Everything when fine"
    exit 0
  else
    echo "ERROR: One or more following repositories failed to sync:"
    cat "$logDir/tmp_$logFile"
    rm -f "$logDir/tmp_$logFile"
    exit 1
  fi
}

# This function call sync script on specified git repository
syncASvnFolder()
{
  # Extract function parameters
  local repoName=$1

  local repoLogDir="$logDir/$repoName"
  local errPath="$repoLogDir/error.log"

  if [ -f "$errPath" ]; then
    echo "Detected that previous ran have error or still running. "
    echo "Please check the error and remove $errPath file"
    return
  fi

  echo "+++++++++ Sync $repoName ($logFile) ..."
  mkdir -p "$repoLogDir"

  (
    cd "$gits/$repoName"
    echo>"$errPath"
    ( source "$sync" ${syncParam[*]} &> "$repoLogDir/$logFile" )
    if [ $? == 0 ]; then
      rm -f "$errPath"
      echo "+++++++++ Sync $repoName ($logFile) finished."
    else
      cat "$repoLogDir/$logFile" >> "$errPath" 
      echo "+++++++++ Sync $repoName ($logFile) failed."
    fi
  ) &

  if [ "$veb" == "yes" ]; then
    tail -f --pid $! "$repoLogDir/$logFile" | sed -e "s/^/\[$repoName\] /" &
  fi
}

setDefaultSettings()
{
  # Set default temp folder
  logFile="`basename $0`_`date +%m%d%y_%H%M%S`_$BASHPID.log"
  logDir="/tmp"
  respoNames="/tmp/respoNames_$BASHPID"
}

main "$@"
