#!/bin/bash
#
# A set of functions can be use for logging with LOG_LEVEL to control which
# type will not be echo on console. LOG_LOCK_FILE can be use when run
# multi process script
#
# A set of exitIf functions can be use for exit with error. EXIT_CMDS can
# specify a set of codes can be executed before the exit.
#

# There are constants for LOG LEVEL
LOG_LEVEL_ERROR=0
LOG_LEVEL_WARN=1
LOG_LEVEL_NOTE=2
LOG_LEVEL_INFO=3
LOG_LEVEL_DEBUG=4

# There are logging configuration variables for display on console
if [[ -z ${LOG_PREFIX+x} ]]; then
   LOG_DEBUG="\e[1m\e[90mDEBUG"
    LOG_INFO=" \e[1mINFO"
    LOG_NOTE=" \e[1m\e[42m\e[97mNOTE\e[0m\e[1m"
    LOG_WARN=" \e[1m\e[43m\e[97mWARN\e[0m\e[1m"
   LOG_ERROR="\e[1m\e[41m\e[97mERROR\e[0m\e[1m"

     LOG_EOL='\e[0m\n'
 LOG_LINEMSG='\e[1m'
LOG_LINECONT='   --'
  LOG_PREFIX=('$time ' '[${file}${line}] ' '$lvlName ')
  LOG_INDENT="                             "
fi

# LOG_LEVEL to specify which log will not be echo on the console
if [[ -z ${LOG_LEVEL+x} ]]; then LOG_LEVEL=$LOG_LEVEL_INFO; fi

# EXIT_CMDS a list of command will be execute before calling exit in
# exitIfErr, exitIf functions
if [[ -z ${EXIT_CMDS+x} ]]; then EXIT_CMDS=(); fi

# $1 - Exit code
# $2 - Exit message
# The rest parameters are a set of code will be execute before exit.
# NOTE: $errCode can be use as $?
exitIfErr()
{
  local errCode=$?
  __exit_if $errCode "`caller`" "$errCode != 0" "$@"
}

# $1 - Condition in single quote. $errCode can be use as $?
# $2 - Exit code
# $3 - Exit message
# The rest parameters are a set of code will be execute before exit.
# NOTE: $errCode can be use as $?
exitIf()
{
  local errCode=$?
  __exit_if $errCode "`caller`" "$@"
}

# $1 - Exit Code
# The rest parameters for exit commands
# NOTE: $errCode can be use as $?
exitClean()
{
  local errCode=$?
  local exitCode=$1
  shift

  if [[ $# != 0 ]]; then 
    (exit $errCode)
    (>&2 eval "$@") || (echo $@; echo `caller`; exit 1)
  fi
  for c in "${EXIT_CMDS[@]}"; do
    (exit $errCode)
    (eval $c) || (echo $c; echo `caller`; exit 1)
  done
  exit $exitCode
}

# All parameter are log messages
DBG()
{
      __log "`caller`" $LOG_LEVEL_DEBUG "$LOG_DEBUG" "" "$@"
}

# All parameter string will be eval
DBG_EVAL()
{
      __log "`caller`" $LOG_LEVEL_DEBUG "$LOG_DEBUG" "eval" "$@"
}

# All parameter are log messages
INFO()
{
      __log "`caller`" $LOG_LEVEL_INFO  "$LOG_INFO" "" "$@"
}

INFO_EVAL()
{
      __log "`caller`" $LOG_LEVEL_INFO  "$LOG_INFO" "eval" "$@"
}

# All parameter are log messages
NOTE()
{
      __log "`caller`" $LOG_LEVEL_NOTE  "$LOG_NOTE" "" "$@"
}

# All parameter are log messages
WARN()
{
      __log "`caller`" $LOG_LEVEL_WARN  "$LOG_WARN" "" "$@"
}

# All parameter are log messages
ERROR()
{
  >&2 __log "`caller`" $LOG_LEVEL_ERROR "$LOG_ERROR" "" "$@"
}

# $1 - Captured value of $?
# $2 - Caller "$line $filename"
# $3 - Test condition
# $4 - Exit Code
# $5 - Exit message
#
# The rest parameters for exit commands
__exit_if()
{
  (exit $1) # Replay the error code
  (eval [[ ! "(" $3 ")" ]]) \
    || { 
      # Check to make sure it not a syntax error
      (eval [[ $3 ]]) || (echo "[[ $3 ]]"; echo `caller`; exit 1)

      __log "$2" LOG_LEVEL_ERROR "$LOG_ERROR" "" "($1) $5"

      (exit $errCode) # Replay the error code
      exitClean $4 "${@:6}"
    }
}

# $1 is caller "$line $filename"
# $2 is log level number
# $3 is log level name
# $4 is ext function
#    if ext is "eval" will apply eval to the rest of parameter for log msg
#    if ext is "" the rest of parameter are log msg
#    otherwise each of the rest of parameters would be executed are with
#    $ext as a command to produce log msg
# the rest is log messages
__log()
{
  if [[ $LOG_LEVEL -lt $2 ]]; then return; fi
  local lvlName=$3
  local caller=$1
  local ext=$4
  shift; shift; shift; shift;

  local time=`date +%H:%M:%S`

  # Take the last 4 digit of source line number
  local line="    ${caller%% *}    "
  case ${#line} in
    9 | 10 | 11 | 12 ) line=":${line:  4:4}";;
    *                ) line=">${line: -7:3}";;
  esac

  # Take the last 10 character of the source filename
  local file="         `basename "${caller#* }"`"
  file="${file: -10}"

  if [ -z "$ext" ]; then
  # Convert \n in $@ into actual newline character, and insert log prefix
    local out="$@"
    out="${out//\\n/$'\n'}"
    
  else
  # Execute each remain params with $ext command
    local first=""
    local out=""
    while [ $# -gt 0 ]; do
      # Double \ to avoid unintended escape character
      local a="${1//\\/\\\\}"

      # Execute $ext command with a parameter
      local tmp=`$ext "$a" 2>&1`

      # Append command and out of the command
      out="${out}${first}>$a
${tmp//\\/\\\\}"

      # Check log prefix to LOG_LINEMSG type
      first="${LOG_EOL}${LOG_INDENT}${LOG_LINEMSG}${lvlName} "
      shift;
    done
  fi

  # Add indent space before each lines
  out="${out//$'\n'/${LOG_EOL}${LOG_INDENT}$LOG_LINECONT $LOG_LINEMSG}$LOG_EOL"

  pre=`eval printf "%s " "\"${LOG_PREFIX[@]}\""` \
    || (echo ${LOG_PREFIX[@]}; echo `caller`; exit 1)

  out="${pre}${out}"

  # Print message to console using flock if specified
  if [[ -z "$LOG_LOCK_FILE" ]]; then
      printf "${out//%/%%}"
  else
    (
      flock -n 9
      printf "${out//%/%%}"
    ) 9> $LOG_LOCK_FILE
  fi
}


