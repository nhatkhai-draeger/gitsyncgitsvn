    '
  )
  if [[ $? -ne 3 ]]; then echo "FAIL"; fi

  LOG_LEVEL=$LOG_LEVEL_DEBUG
  DBG_EVAL  'echo "#11 THIS IS A DBG_EVAL Message"'
  INFO_EVAL 'echo "#12 THIS IS A INFO_EVAL\\a Message"'
fi
