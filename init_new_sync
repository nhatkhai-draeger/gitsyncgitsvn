#!/bin/bash
# TODO - Describe this script
#

# Specify location of sync script
scriptDir="$(cd "$(dirname "$0")"; pwd -P)"
source "$scriptDir/logging"

showHelp () 
{
  cat <<EOF
`basename "$0"` [options] [Sync_Script_Options] [{SVN_FOLDER_A}]

This script should be called by scheduler to sync change between SVN and Git 
repositories.

Options:

  -h, --help
    Show this message.

  --noflock
    Don't use flock - to avoid error for some system.

  -f, --force
    Try to force push to origin remote. This can remove the entile repos 
    history. Use with care.

  -t, --threads N_MAX_THREADS
      Specifiy maximum number of thread run at one time. (Default $max_threads)

  -v, --verbose
    Turn on detail run log

  -g, --gitDir GITS_PATH
      Specifiy where all the synch git repositories location. 
      (Default $gits)

  --gitDot DOTGIT_FILES_LOCATION
    Specify folder that contain .gitignore, .gitattribute, and other .git*
    files to create an initial configuration for the git repository.

  --gitUrl GIT_URL
    GIT_URL is a base git url. The repository name will be assume the same as
    SVN_FOLDER_A values without the space characters. For example abc\xyz.git:
      GIT_URL would be abc
      SVN_FOLDER_A would be xyz

Sync_Script_Options:
  NOTE: Use full option names for passing value, use short option names for
  not required passing value
EOF
"$sync" -h
} # end of showHelp

main()
{
  setDefaultSettings
  error_files=()

  # Go through all arguments
  while [[ ! -z "$1" ]]; do
    if [[ $1 =~ ^-h|--help$     ]]; then showHelp; return; fi

    if [[ $1 =~ ^--noflock$     ]]; then flock='no';              shift;        continue; fi
    if [[ $1 =~ ^-f|--force$    ]]; then gitPushOpt="-f";         shift;        continue; fi
    if [[ $1 =~ ^-t|--threads$  ]]; then max_threads=$2;          shift; shift; continue; fi
    if [[ $1 =~ ^-v|--verbose$  ]]; then veb="yes";               shift;        continue; fi

    if [[ $1 =~ ^-g|--gitDir$   ]]; then gits=`realpath "$2"`;    shift; shift; continue; fi
    if [[ $1 =~ ^--gitDot$      ]]; then gitDOT=`realpath "$2"`;  shift; shift; continue; fi
    if [[ $1 =~ ^--gitUrl$      ]]; then gitURL="$2";             shift; shift; continue; fi

    # These are Sync Options
    if [[ $1 =~ ^--authors$ ]]; then authorFile=`realpath "$2"`;  shift; shift; continue; fi
    if [[ $1 =~ ^--svnPwd$  ]]; then svnPwd="$2";                 shift; shift; continue; fi
    if [[ $1 =~ ^--svnUrl$  ]]; then svnURL="$2";                 shift; shift; continue; fi
    if [[ $1 =~ ^--svnUser$ ]]; then svnUser="$2";                shift; shift; continue; fi

    if [[ $1 =~ ^--[a-zA-Z].*$ ]]; then syncOps+=("$1" "$2");     shift; shift; continue; fi;
    if [[ $1 =~ ^-[a-zA-Z]*$   ]]; then syncOps+=("$1" "");       shift;        continue; fi;

    repos+=("$1"); shift;
  done

  # Check required option
  exitIf '-z "$gitDOT"' 1 "Need to specify gitDot -- path where .git* files"
  exitIf '-z "$gitURL"' 1 "Need to specify gitUrl"

  exitIf '-z "$svnPwd"'  1 "Need to specify svnPwd"
  exitIf '-z "$svnURL"'  1 "Need to specify svnUrl"
  exitIf '-z "$svnUser"' 1 "Need to specify svnUser"
  syncOps+=(--svnUrl "$svnURL" --svnUser "$svnUser" --svnPwd "$svnPwd")
  if [[ -n "$authorFile" ]]; then syncOps+=(--authors "$authorFile"); fi

  # Spin up threads
  pushd "$gits"
  for f in "${repos[@]}"; do 
    waitNThreads "$logDir/" "/lock" "$max_threads" " on $f"
    work_on "$f";
  done
  popd

  # Wait for all the process finished
  wait
  sleep 1

  # Check weather any error occurred
  for err in "${error_files[@]}"; do
    if [ -f "$err" ]; then echo $err >> "$logDir/tmp_$logFile"; fi
  done
  exitIf '-f "$logDir/tmp_$logFile"' 1 \
    "One or more following repositories failed to initialize:" \
    'cat "$logDir/tmp_$logFile"'

  INFO "DONE: Everything went fine."
  exitClean
}

work_on()
{
  local svn_dir_name="$1"
  local git_dirname="${svn_dir_name// /}"
  git_dirname="${git_dirname//\//-}"

  local repoLogDir="$logDir/${git_dirname}"
  local errPath="$repoLogDir/error.log"
  local lock="$repoLogDir/lock"

  error_files+=("$errPath")

  mkdir -p "$repoLogDir"
  (
    EXIT_CMDS=()
    if [[ "$flock" == "yes" ]]; then flock -n 9; fi
    exitIfErr 0 "Other process is still running. 
    If not, please remove $lock file."

    EXIT_CMDS=("rm -f \"$lock\"")
    INFO "++++ Initialize $git_dirname...."
    (
      if [ "$gitPushOpt" == "-f" ]; then 
        rm -rf "${git_dirname}" 
      fi

      mkdir -p "${git_dirname}" 
      pushd "${git_dirname}"
      exitIfErr 1 "Cannot create folder $git_dirname"

      git init
      cp "${gitDOT}/.git"* .  
      exitIfErr 1 "Cannot copy .git* files from $gitDOT"

      git add .git*
      git commit -m "Initial repo setting"
      exitIf '$errCode -gt 1' 1 "Cannot make initial commit"

      git remote add origin "${gitURL}/${git_dirname}.git"
      exitIfErr 1 "Cannot add git remote"

      "${sync}" --init "$svn_dir_name" "${syncOps[@]}" || exit $?
      popd
    ) &> "$repoLogDir/$logFile"
    exitIfErr 1 "++++++ $git_dirname is failed." '
      ln -f "$repoLogDir/$logFile" "$errPath"
    '

    INFO "+++++++ $git_dirname is initialized."
    exitClean
  ) 9> "$lock" &

  if [ "$veb" == "yes" ]; then
    for (( i=0 ; i<10 ; i++ )) do
      if [[ -f "$repoLogDir/$logFile" ]]; then 
        local name="              $git_dirname"
        tail -f --pid $! "$repoLogDir/$logFile" \
          | sed -e "s/^/\[${name: -15}\] /" 2>/dev/null &
        break;
      fi
      sleep 1
    done
  fi
}

cleanUp()
{
  INFO "Cleaning up..."
  rm -f "$logDir/tmp_$logFile" &>/dev/null
}

setDefaultSettings()
{
  sync="${scriptDir}/sync"

  # Set default temp folder
  logFile="`basename "$0"`_`date +%m%d%y_%H%M%S`_$BASHPID.log"
  logDir="/tmp/`basename "$scriptDir"`"
  local temp=`cygpath -m "$logDir"`
  if [ $? == 0 ]; then logDir=$temp; fi

  max_threads=5
  flock="yes"

  # Specify location of all local git repository path
  gits="${scriptDir}/../cached_repos"

  syncOps=()
  repos=()
}

EXIT_CMDS=(cleanUp)
main "$@"
